---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Join Us — Write for Lightning Sports" description="Passionate about a sport? Write for Lightning Sports and take your fandom to the next level.">
<style>
  .join-hero{
    background:
      radial-gradient(ellipse 700px 420px at 85% -10%, rgba(242,166,61,.16), transparent 60%),
      radial-gradient(ellipse 600px 500px at 0% 30%, rgba(255,68,56,.1), transparent 60%),
      var(--t-bg);
    color:var(--t-ink); padding:76px 0 64px;
  }
  .join-hero .eyebrow{color:var(--t-accent); margin-bottom:20px;}
  .join-hero h1{font-family:var(--font-display); font-weight:400; font-size:clamp(38px,6.5vw,66px); line-height:1.02; max-width:16ch; margin-bottom:22px; text-transform: uppercase;}
  .join-hero h1 .accent{color:var(--t-accent);}
  .join-hero p.lede{color:var(--t-ink-muted); font-size:17px; max-width:58ch; margin-bottom:30px;}
  .hero-cta{display:flex; gap:14px; flex-wrap:wrap;}
  .btn{font-family:var(--font-mono); font-weight:600; font-size:13px; letter-spacing:.06em; text-transform:uppercase; padding:14px 24px; border-radius:3px; display:inline-block; transition:transform .15s ease;}
  .btn-primary{background:var(--t-accent); color:var(--t-bg);}
  .btn-primary:hover{transform:translateY(-2px);}
  .btn-ghost{border:1px solid var(--t-line); color:var(--t-ink);}
  .btn-ghost:hover{border-color:var(--t-accent); color:var(--t-accent);}

  section{padding:88px 0;}
  .section-head{margin-bottom:44px; max-width:60ch;}
  .section-head .eyebrow{color:var(--t-accent); margin-bottom:14px;}
  .section-head h2{font-family:var(--font-display); font-weight:400; font-size:clamp(28px,4vw,42px); text-transform: uppercase;}
  .section-head p{color:var(--t-ink-muted); margin-top:12px; font-size:15px;}

  .perks-grid{display:grid; grid-template-columns:repeat(3,1fr); gap:22px;}
  @media (max-width:820px){ .perks-grid{grid-template-columns:1fr 1fr;} }
  @media (max-width:560px){ .perks-grid{grid-template-columns:1fr;} }
  
  /* Contrast Fix Here */
  .perk-card{background:var(--t-surface); border:1px solid var(--t-line); border-radius:8px; padding:28px; transition:transform .15s ease, box-shadow .15s ease;}
  .perk-card:hover{transform:translateY(-3px); box-shadow:0 16px 30px -20px rgba(0,0,0,.6);}
  .perk-card .num{font-family:var(--font-display); font-size:26px; color:var(--t-accent); display:block; margin-bottom:16px;}
  .perk-card h4{font-size:16.5px; margin-bottom:10px;}
  .perk-card p{font-size:13.5px; color:var(--t-ink-muted);}

  .sports-band{background:var(--t-surface); color:var(--t-ink); border-top: 1px solid var(--t-line); border-bottom: 1px solid var(--t-line);}
  .sports-band .eyebrow{color:var(--t-accent);}
  .chip-wrap{display:flex; flex-wrap:wrap; gap:12px;}
  .sport-chip{
    font-family:var(--font-mono); font-size:13px; text-transform:uppercase; letter-spacing:.05em; font-weight:600;
    padding:12px 20px; border:1px solid var(--t-line); border-radius:24px; color:var(--t-ink);
    transition:border-color .15s ease, background .15s ease;
  }
  .sport-chip:hover{border-color:var(--t-accent); background:color-mix(in oklab, var(--t-accent) 10%, transparent);}
  .sports-note{font-size:14px; color:var(--t-ink-muted); margin-top:24px; max-width:60ch;}

  .process-steps{display:grid; grid-template-columns:repeat(4,1fr); gap:4px; counter-reset:step;}
  @media (max-width:820px){ .process-steps{grid-template-columns:1fr 1fr;} }
  @media (max-width:520px){ .process-steps{grid-template-columns:1fr;} }
  .step{padding:24px 20px 24px 0; border-left:2px solid var(--t-line); padding-left:22px; position:relative;}
  .step::before{
    counter-increment:step; content:counter(step,decimal-leading-zero);
    font-family:var(--font-mono); font-size:12px; color:var(--t-accent); display:block; margin-bottom:10px;
  }
  .step h4{font-size:15px; margin-bottom:8px;}
  .step p{font-size:13px; color:var(--t-ink-muted);}

  .apply{background:var(--t-bg); color:var(--t-ink);}
  .apply .eyebrow{color:var(--t-accent);}
  .apply-panel{
    border:1px solid var(--t-line); border-radius:10px; padding:48px;
    background:linear-gradient(135deg, color-mix(in oklab, var(--t-accent) 5%, transparent), transparent 60%);
  }
  @media (max-width:640px){ .apply-panel{padding:28px 22px;} }
  .form-grid{display:grid; grid-template-columns:1fr 1fr; gap:18px; margin-top:8px;}
  @media (max-width:640px){ .form-grid{grid-template-columns:1fr;} }
  .form-grid .full{grid-column:1 / -1;}
  label{display:block; font-family:var(--font-mono); font-size:11px; text-transform:uppercase; letter-spacing:.08em; color:var(--t-ink-muted); margin-bottom:8px;}
  input, select, textarea{
    width:100%; background:var(--t-surface); border:1px solid var(--t-line); border-radius:4px; color:var(--t-ink);
    padding:13px 14px; font-family:var(--font-body); font-size:14px;
  }
  input::placeholder, textarea::placeholder{color:var(--t-ink-muted); opacity:.7;}
  input:focus, select:focus, textarea:focus{outline:none; border-color:var(--t-accent);}
  textarea{resize:vertical; min-height:110px;}
  .apply-panel .submit-btn{
    margin-top:26px; background:var(--t-accent); color:var(--t-bg); border:none; padding:15px 30px; border-radius:4px;
    font-family:var(--font-mono); font-weight:700; text-transform:uppercase; letter-spacing:.06em; font-size:13px; cursor:pointer;
  }
  .form-note{font-family:var(--font-mono); font-size:11px; color:var(--t-ink-muted); margin-top:14px;}
</style>

<div class="breadcrumb">
  <div class="wrap"><a href="/">Home</a><span class="sep">/</span><span class="current">Join Us</span></div>
</div>

<section class="join-hero">
  <div class="wrap">
    <span class="eyebrow"><span class="dot"></span>We're recruiting writers</span>
    <h1>Passionate about sport? <span class="accent">Write for us.</span></h1>
    <p class="lede">It doesn't matter which sport — cricket, football, tennis, kabaddi, chess, esports, athletics, all of it. If you follow a sport closely enough to have opinions about it, we want to help you turn that passion into published work.</p>
    <div class="hero-cta">
      <a href="#apply" class="btn btn-primary">Apply now</a>
      <a href="#why" class="btn btn-ghost">Why write for us</a>
    </div>
  </div>
</section>

<section id="why">
  <div class="wrap">
    <div class="section-head">
      <span class="eyebrow"><span class="dot"></span>Why write for us</span>
      <h2>Take your fandom to the next level</h2>
      <p>You already watch every match, argue every call, and know the squad better than the commentators. Here's what you get by putting that to work.</p>
    </div>
    <div class="perks-grid">
      <div class="perk-card"><span class="num">01</span><h4>A real byline</h4><p>Your name, on your stories, published for an actual audience — not another anonymous forum post.</p></div>
      <div class="perk-card"><span class="num">02</span><h4>Cover what you love</h4><p>No assignments on sports you don't follow. Pitch and write about the one (or two) you actually care about.</p></div>
      <div class="perk-card"><span class="num">03</span><h4>Full editorial support</h4><p>Feedback on your writing, help shaping angles, and a real editor reading your drafts — not silence into a void.</p></div>
      <div class="perk-card"><span class="num">04</span><h4>A growing platform</h4><p>Join early and grow with the site — from tournament coverage to the weekly newsletter your writing helps fill.</p></div>
      <div class="perk-card"><span class="num">05</span><h4>Flexible commitment</h4><p>Write around a tournament you're excited about — this isn't a daily quota, it's built around when sport actually happens.</p></div>
      <div class="perk-card"><span class="num">06</span><h4>A community of fans</h4><p>Work alongside other contributors who'll argue the same debates you do — just with a byline attached.</p></div>
    </div>
  </div>
</section>

<section class="sports-band">
  <div class="wrap">
    <div class="section-head">
      <span class="eyebrow"><span class="dot"></span>Any sport, seriously</span>
      <h2 style="color:var(--t-ink);">What are you passionate about?</h2>
    </div>
    <div class="chip-wrap">
      <span class="sport-chip">Cricket</span>
      <span class="sport-chip">Football</span>
      <span class="sport-chip">Tennis</span>
      <span class="sport-chip">Olympics</span>
      <span class="sport-chip">Kabaddi</span>
      <span class="sport-chip">Badminton</span>
      <span class="sport-chip">Athletics</span>
      <span class="sport-chip">Hockey</span>
      <span class="sport-chip">Chess</span>
      <span class="sport-chip">Esports</span>
      <span class="sport-chip">Formula 1</span>
      <span class="sport-chip">Something else entirely</span>
    </div>
    <p class="sports-note">Don't see your sport listed? Doesn't matter — if you can write about it with real knowledge and enthusiasm, we're interested. Niche coverage is exactly how this site started.</p>
  </div>
</section>

<section>
  <div class="wrap">
    <div class="section-head">
      <span class="eyebrow"><span class="dot"></span>How it works</span>
      <h2>Four steps to your first byline</h2>
    </div>
    <div class="process-steps">
      <div class="step"><h4>Apply</h4><p>Tell us your sport, your writing background (or lack of one), and why you want in.</p></div>
      <div class="step"><h4>Quick chat</h4><p>A short, informal conversation — no formal interview, just making sure it's a good fit both ways.</p></div>
      <div class="step"><h4>Trial piece</h4><p>Write one story on a topic you're excited about, with editorial feedback along the way.</p></div>
      <div class="step"><h4>You're in</h4><p>Published, credited, and part of the team — pitching your own stories from here on.</p></div>
    </div>
  </div>
</section>

<section class="apply" id="apply">
  <div class="wrap">
    <div class="section-head">
      <span class="eyebrow"><span class="dot"></span>Application</span>
      <h2 style="color:var(--t-ink);">Tell us about you</h2>
    </div>
    <div class="apply-panel">
      <form onsubmit="event.preventDefault(); const btn=this.querySelector('.submit-btn'); btn.textContent='Application sent ✓'; btn.disabled=true;">
        <div class="form-grid">
          <div>
            <label for="name">Full name</label>
            <input id="name" type="text" placeholder="Your name" required>
          </div>
          <div>
            <label for="email">Email address</label>
            <input id="email" type="email" placeholder="you@email.com" required>
          </div>
          <div>
            <label for="sport">Sport you follow most</label>
            <input id="sport" type="text" placeholder="e.g. Cricket, Football, Chess...">
          </div>
          <div>
            <label for="experience">Writing experience</label>
            <select id="experience">
              <option>None — but I want to start</option>
              <option>Some — blog, college paper, socials</option>
              <option>Published elsewhere before</option>
            </select>
          </div>
          <div class="full">
            <label for="sample">Link to any past writing (optional)</label>
            <input id="sample" type="url" placeholder="https://...">
          </div>
          <div class="full">
            <label for="message">Why do you want to write for Lightning Sports?</label>
            <textarea id="message" placeholder="Tell us a bit about your passion for the sport, and what you'd want to cover first."></textarea>
          </div>
        </div>
        <button type="submit" class="submit-btn">Submit application</button>
        <p class="form-note">We read every application personally — expect a reply within a few days.</p>
      </form>
    </div>
  </div>
</section>
</BaseLayout>