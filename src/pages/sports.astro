---
// src/pages/sports.astro
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const allPosts = await getCollection('posts');

const counts = new Map<string, number>();
for (const p of allPosts) {
  counts.set(p.data.category, (counts.get(p.data.category) ?? 0) + 1);
}
const liveCategories = [...counts.entries()].sort((a, b) => b[1] - a[1]);

// Sports you plan to cover but haven't published in yet.
// Edit this list any time — no code changes needed elsewhere.
const comingSoon = ['kabaddi', 'badminton', 'athletics', 'esports', 'formula-1'];
const notYetLive = comingSoon.filter((c) => !counts.has(c));

function label(cat: string) {
  return cat.replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase());
}
---
<BaseLayout title="All Sports — Lightning Sports" description="Every sport Lightning Sports covers, and what's coming next.">
<style>
  .sports-hero{
    background:
      radial-gradient(ellipse 700px 420px at 15% -10%, rgba(242,166,61,.14), transparent 60%),
      var(--ink);
    color:var(--chalk); padding:60px 0 70px;
  }
  .sports-hero .eyebrow{color:var(--scarlet); margin-bottom:16px;}
  .sports-hero h1{font-family:var(--font-display); font-weight:400; font-size:clamp(38px,6.5vw,64px); line-height:1;}
  .sports-hero p{color:var(--slate); margin-top:14px; max-width:56ch; font-size:16px;}

  section.grid-wrap{padding:70px 0;}
  .section-label{font-family:var(--font-mono); font-size:11px; letter-spacing:.12em; text-transform:uppercase; color:#5b6472; margin-bottom:26px; display:flex; align-items:center; gap:8px;}
  .section-label::before{content:""; width:16px; height:2px; background:var(--scarlet);}

  .sport-grid{display:grid; grid-template-columns:repeat(3,1fr); gap:20px;}
  @media (max-width:820px){ .sport-grid{grid-template-columns:1fr 1fr;} }
  @media (max-width:560px){ .sport-grid{grid-template-columns:1fr;} }

  .sport-card{
    background:var(--ink); color:var(--chalk); border-radius:10px; padding:30px;
    position:relative; overflow:hidden; min-height:160px;
    display:flex; flex-direction:column; justify-content:flex-end;
    transition:transform .18s ease;
  }
  .sport-card:hover{transform:translateY(-4px);}
  .sport-card::before{
    content:""; position:absolute; inset:0;
    background:radial-gradient(ellipse 300px 200px at 90% 0%, rgba(242,166,61,.16), transparent 60%);
  }
  .sport-card .count{position:relative; font-family:var(--font-mono); font-size:11px; color:var(--volt); text-transform:uppercase; letter-spacing:.08em; margin-bottom:10px;}
  .sport-card h3{position:relative; font-family:var(--font-display); font-weight:400; font-size:26px;}

  .coming-grid{display:grid; grid-template-columns:repeat(5,1fr); gap:16px;}
  @media (max-width:820px){ .coming-grid{grid-template-columns:1fr 1fr 1fr;} }
  @media (max-width:560px){ .coming-grid{grid-template-columns:1fr 1fr;} }
  .coming-card{
    border:1px dashed #DEDACB; border-radius:8px; padding:22px 16px; text-align:center;
    color:#5b6472; font-family:var(--font-mono); font-size:12px; text-transform:uppercase; letter-spacing:.05em;
  }
  .coming-card span{display:block; font-family:var(--font-display); font-size:15px; text-transform:none; color:var(--ink); margin-bottom:8px; letter-spacing:0;}
</style>

<div class="breadcrumb"><div class="wrap"><a href="/">Home</a><span class="sep">/</span><span class="current">All Sports</span></div></div>

<section class="sports-hero">
  <div class="wrap">
    <span class="eyebrow"><span class="dot"></span>Every beat, one roster</span>
    <h1>All the sports we cover</h1>
    <p>From tournaments we're covering right now to the ones we're gearing up to add — this is the full lineup.</p>
  </div>
</section>

<section class="grid-wrap">
  <div class="wrap">
    <div class="section-label">Currently covering</div>
    <div class="sport-grid">
      {liveCategories.map(([cat, count]) => (
        <a class="sport-card" href={`/category/${cat}`}>
          <span class="count">{count} {count === 1 ? 'story' : 'stories'}</span>
          <h3>{label(cat)}</h3>
        </a>
      ))}
    </div>
  </div>
</section>

{notYetLive.length > 0 && (
  <section class="grid-wrap" style="padding-top:0;">
    <div class="wrap">
      <div class="section-label">Coming soon</div>
      <div class="coming-grid">
        {notYetLive.map((cat) => (
          <div class="coming-card"><span>{label(cat)}</span>In the works</div>
        ))}
      </div>
    </div>
  </section>
)}
</BaseLayout>
