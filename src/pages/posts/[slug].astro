---
// src/pages/posts/[slug].astro
export const prerender = false;

import { kv } from '@vercel/kv';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import EngagementBar from '../../components/EngagementBar.astro';
import { slugify } from '../../lib/categoryTypes';
import { getFirstImage } from '../../lib/postImages';

// FIX: Fetch the post dynamically using the URL param instead of getStaticPaths
const { slug } = Astro.params;
const allPosts = await getCollection('posts');
const post = allPosts.find((p) => p.id === slug);

// If post isn't found, redirect to 404 instead of crashing
if (!post) {
  return Astro.redirect('/404');
}

const { Content } = await render(post);

const postCategories: string[] = Array.isArray(post.data.category) ? post.data.category : [post.data.category];
const primaryCategory = postCategories[0] ?? 'Sports';

if (import.meta.env.PROD && post.id) {
  try { await kv.incr(`views:${post.id}`); } catch { /* ignore */ }
}

let views = 0;
let likes = 0;
try {
  views = (await kv.get<number>(`views:${post.id}`)) || 0;
  likes = (await kv.get<number>(`likes:${post.id}`)) || 0;
} catch { /* ignore */ }

const related = allPosts
  .filter((p) => p.id !== post.id && (Array.isArray(p.data.category) ? p.data.category : [p.data.category]).some((c: string) => postCategories.includes(c)))
  .slice(0, 3);

const heroImage = getFirstImage(post.body);
function fmt(d: Date) { return new Date(d).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }); }
const cleanTitle = (title: string) => title.replace(/^["']|["']$/g, '');

const words = (post.body || '').split(/\s+/).length;
const readMin = Math.max(1, Math.round(words / 200));
---
<BaseLayout title={`${post.data.title} — Lightning Sports`} description={post.data.dek} sport={primaryCategory}>
<style>
  .article-hero {
    position: relative;
    padding: 60px 0 40px; /* FIX: Reduced padding */
    background: var(--t-bg); /* FIX: Removed aggressive gradient hiding text */
  }
  .article-hero .wrap { position: relative; z-index: 2; max-width: 940px; }

  .tag-row { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 20px; }
  .cat-tag {
    font-family: var(--font-mono); font-size: 11px; letter-spacing: .16em;
    text-transform: uppercase; font-weight: 600;
    padding: 8px 14px; border-radius: 999px;
    background: color-mix(in oklab, var(--t-accent) 15%, transparent);
    color: var(--t-accent);
    border: 1px solid color-mix(in oklab, var(--t-accent) 30%, transparent);
  }

  .article-hero h1 {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(32px, 5vw, 64px); /* FIX: Scaled down massive font */
    line-height: 1.1; letter-spacing: -.02em;
    color: var(--t-ink);
    margin-bottom: 24px;
  }
  .article-hero .dek {
    font-family: var(--font-editorial); font-style: italic;
    font-size: clamp(18px, 2vw, 24px);
    color: var(--t-ink-muted); line-height: 1.5;
    max-width: 55ch; margin-bottom: 30px;
  }

  .byline {
    display: flex; align-items: center; gap: 18px; flex-wrap: wrap;
    padding: 20px 0; border-top: 1px solid var(--t-line);
  }
  .avatar {
    width: 40px; height: 40px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    background: color-mix(in oklab, var(--t-accent) 18%, transparent);
    border: 1px solid color-mix(in oklab, var(--t-accent) 30%, transparent);
    color: var(--t-accent);
    font-family: var(--font-display); font-size: 15px; font-weight: 500;
  }
  .byline-info { display: flex; flex-direction: column; }
  .byline-info .name { font-weight: 600; font-size: 14px; color: var(--t-ink); }
  .byline-info .meta { font-family: var(--font-mono); font-size: 11.5px; color: var(--t-ink-muted); margin-top: 3px; }
  .byline-stats { margin-left: auto; display: flex; gap: 20px; font-family: var(--font-mono); font-size: 11.5px; color: var(--t-ink-muted); }
  .byline-stats b { color: var(--t-ink); font-weight: 500; }

  .hero-image {
    max-width: 1000px; margin: 20px auto 40px; padding: 0 var(--shell-pad);
  }
  .hero-image img {
    width: 100%; border-radius: 16px; aspect-ratio: 16 / 9; object-fit: cover;
    border: 1px solid var(--t-line);
  }

  .article-wrap { background: var(--t-bg); padding: 20px 0 60px; }
  .prose {
    max-width: 68ch; margin: 0 auto;
    font-family: var(--font-editorial);
    font-size: 20px; line-height: 1.75;
    color: var(--t-ink);
    padding: 0 var(--shell-pad);
  }
  .prose :global(p) { margin-bottom: 26px; }
  .prose :global(h1), .prose :global(h2) {
    font-family: var(--font-display); font-weight: 500;
    font-size: 28px; line-height: 1.2; margin: 40px 0 20px; color: var(--t-ink);
  }
  .prose :global(a) { color: var(--t-accent); text-decoration: underline; }
  .prose :global(img) { max-width: 100%; border-radius: 12px; margin: 30px auto; }
</style>

<div class="breadcrumb">
  <div class="wrap">
    <a href="/">Home</a><span class="sep">/</span>
    <a href={`/category/${slugify(primaryCategory)}`}>{primaryCategory}</a><span class="sep">/</span>
    <span class="current">{cleanTitle(post.data.title).slice(0, 60)}</span>
  </div>
</div>

<section class="article-hero">
  <div class="wrap" data-reveal>
    <div class="tag-row">
      {postCategories.map((c) => (<a href={`/category/${slugify(c)}`} class="cat-tag">{c}</a>))}
    </div>
    <h1>{cleanTitle(post.data.title)}</h1>
    {post.data.dek && <p class="dek">{post.data.dek}</p>}
    <div class="byline">
      <div class="avatar">{post.data.author.split(' ').map((n: string) => n[0]).join('').slice(0,2)}</div>
      <div class="byline-info">
        <span class="name">{post.data.author}</span>
        <span class="meta">{fmt(post.data.date)} · {readMin} min read</span>
      </div>
      <div class="byline-stats">
        <span><b>{views.toLocaleString()}</b> views</span>
        <span><b>{likes.toLocaleString()}</b> likes</span>
      </div>
    </div>
  </div>
</section>

{heroImage && (
  <div class="hero-image" data-reveal>
    <img src={heroImage} alt={post.data.title} loading="eager" />
  </div>
)}

<section class="article-wrap">
  <article class="prose"><Content /></article>
  <EngagementBar postId={post.id} initialLikes={likes} />
</section>
</BaseLayout>