---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="About Us — Lightning Sports" description="Meet the person behind Lightning Sports — one place for all your sports news.">
<style>
  .about-hero{
    background:
      radial-gradient(ellipse 700px 420px at 15% -10%, rgba(242,166,61,.14), transparent 60%),
      radial-gradient(ellipse 600px 500px at 100% 10%, rgba(255,68,56,.1), transparent 60%),
      var(--t-bg);
    color:var(--t-ink); padding:60px 0 80px;
  }
  .about-hero .eyebrow{color:var(--t-accent); margin-bottom:18px;}
  /* REDUCED H1 SIZE AND MORE BALANCED HIRING-FRIENDLY TEXT */
  .about-hero h1{font-family:var(--font-display); font-weight:400; font-size:clamp(28px, 4vw, 46px); line-height:1.1; margin-bottom:20px; text-transform: uppercase; max-width: 24ch;}
  .about-hero p.lede{color:var(--t-ink-muted); font-size:17px; max-width:56ch;}

  .profile{padding:0 0 90px; margin-top:-56px;}
  .profile-card{
    background:var(--t-surface); border:1px solid var(--t-line); border-radius:10px; padding:44px;
    display:grid; grid-template-columns:200px 1fr; gap:44px; align-items:start;
    box-shadow:0 24px 48px -30px rgba(0,0,0,.6);
  }
  @media (max-width:680px){ .profile-card{grid-template-columns:1fr; text-align:center;} }
  .avatar-ring{
    width:180px; height:180px; border-radius:50%; overflow:hidden; border:4px solid var(--t-bg);
    background:linear-gradient(135deg, var(--t-bg), var(--t-surface)); display:flex; align-items:center; justify-content:center;
    font-family:var(--font-display); font-size:46px; color:var(--t-accent); margin:0 auto;
  }
  .profile-card h2{font-family:var(--font-display); font-weight:400; font-size:30px; margin-bottom:4px; text-transform: uppercase;}
  .profile-card .role{font-family:var(--font-mono); font-size:12px; color:var(--t-ink-muted); text-transform:uppercase; letter-spacing:.1em; margin-bottom:18px; display:block;}
  .profile-card p{font-size:16px; color:var(--t-ink-muted); margin-bottom:14px; max-width:56ch;}
  .profile-contact{display:flex; flex-wrap:wrap; gap:12px; margin-top:20px;}
  @media (max-width:680px){ .profile-contact{justify-content:center;} }
  .profile-contact a{
    font-family:var(--font-mono); font-size:12.5px; padding:9px 16px; border:1px solid var(--t-line); border-radius:20px; color:var(--t-ink);
    display:inline-flex; align-items:center; gap:6px; transition:border-color .15s ease, background .15s ease;
  }
  .profile-contact a:hover{border-color:var(--t-accent); background:color-mix(in oklab, var(--t-accent) 10%, transparent);}

  .mission{background:var(--t-surface); border-top: 1px solid var(--t-line); border-bottom: 1px solid var(--t-line); color:var(--t-ink); padding:80px 0;}
  .mission .section-head{margin-bottom:44px;}
  .mission .eyebrow{color:var(--t-accent);}
  .mission h2{font-family:var(--font-display); font-weight:400; font-size:clamp(28px,4.4vw,42px); margin-top:14px; max-width:16ch; text-transform: uppercase;}
  .mission-grid{display:grid; grid-template-columns:1.1fr 1fr; gap:50px; align-items:start;}
  @media (max-width:820px){ .mission-grid{grid-template-columns:1fr;} }
  .mission-grid p{color:var(--t-ink-muted); font-size:16px; margin-bottom:18px; max-width:52ch;}
  .stat-grid{display:grid; grid-template-columns:1fr 1fr; gap:16px;}
  .stat-box{border:1px solid var(--t-line); border-radius:8px; padding:24px; background:rgba(255,255,255,.02);}
  .stat-box b{font-family:var(--font-display); font-size:30px; color:var(--t-accent); display:block; margin-bottom:6px; font-weight:400;}
  .stat-box span{font-family:var(--font-mono); font-size:11.5px; color:var(--t-ink-muted); text-transform:uppercase; letter-spacing:.06em;}

  .coverage{padding:88px 0;}
  .section-head{margin-bottom:44px;}
  .section-head .eyebrow{color:var(--t-accent); margin-bottom:14px;}
  .section-head h2{font-family:var(--font-display); font-weight:400; font-size:clamp(28px,4vw,42px); text-transform: uppercase;}
  .cov-grid{display:grid; grid-template-columns:repeat(4,1fr); gap:18px;}
  @media (max-width:920px){ .cov-grid{grid-template-columns:1fr 1fr;} }
  @media (max-width:520px){ .cov-grid{grid-template-columns:1fr;} }
  
  .cov-tile{background:var(--t-surface); border:1px solid var(--t-line); border-radius:8px; padding:26px 22px; transition:transform .15s ease, box-shadow .15s ease;}
  .cov-tile:hover{transform:translateY(-3px); box-shadow:0 16px 30px -20px rgba(0,0,0,.6);}
  .cov-tile .ic{font-family:var(--font-display); font-size:22px; color:var(--t-accent); margin-bottom:14px; display:block;}
  .cov-tile h4{font-size:16px; margin-bottom:8px; color:var(--t-ink);}
  .cov-tile p{font-size:13px; color:var(--t-ink-muted);}

  .socials-cta{background:var(--t-bg); color:var(--t-ink); padding:70px 0; text-align:center;}
  .socials-cta h2{font-family:var(--font-display); font-weight:400; font-size:clamp(26px,4vw,36px); margin-bottom:14px; text-transform: uppercase;}
  .socials-cta p{color:var(--t-ink-muted); max-width:48ch; margin:0 auto 30px;}
  .social-row{display:flex; justify-content:center; gap:14px;}
  .social-row a{
    width:48px; height:48px; border:1px solid var(--t-line); border-radius:50%; display:flex; align-items:center; justify-content:center;
    font-size:16px; transition:border-color .15s ease, color .15s ease, transform .15s ease;
  }
  .social-row a:hover{border-color:var(--t-accent); color:var(--t-accent); transform:translateY(-3px);}
</style>

<div class="breadcrumb">
  <div class="wrap"><a href="/">Home</a><span class="sep">/</span><span class="current">About Us</span></div>
</div>

<section class="about-hero">
  <div class="wrap">
    <span class="eyebrow"><span class="dot"></span>The person behind the byline</span>
    <!-- BALANCED TEXT, SMALLER SIZE -->
    <h1>A unified sports newsroom built for the modern fan.</h1>
    <p class="lede">Lightning Sports began as a simple idea: merge a love of computers with a love of sport, and build somewhere fans could get it all in one place.</p>
  </div>
</section>

<section class="profile">
  <div class="wrap">
    <div class="profile-card">
      <div class="avatar-ring">TK</div>
      <div>
        <span class="role">Founder &amp; Editor</span>
        <h2>Tejas Khanna</h2>
        <p>Hi! I'm Tejas — I'm from India, a sports enthusiast, and currently a student. I've always been particularly interested in computers and sports, so I merged the two and built this website.</p>
        <p>Hope you enjoy!</p>
        <div class="profile-contact">
          <a href="mailto:tejaskhanna15@gmail.com">✉ tejaskhanna15@gmail.com</a>
          <a href="https://twitter.com/TejasKhanna14" target="_blank" rel="noopener noreferrer">𝕏 @TejasKhanna14</a>
          <a href="https://facebook.com" target="_blank" rel="noopener noreferrer">Facebook</a>
          <a href="https://instagram.com" target="_blank" rel="noopener noreferrer">Instagram</a>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="mission">
  <div class="wrap">
    <div class="mission-grid">
      <div>
        <div class="section-head">
          <span class="eyebrow"><span class="dot"></span>Why we exist</span>
          <h2>Sport moves fast. Your news should too.</h2>
        </div>
        <p>Lightning Sports was built on a simple frustration: too many sites bury the story you actually want under ads, unrelated content, and slow load times. We wanted one place — fast, clean, and written by someone who actually watches the match.</p>
        <p>What started with Tokyo 2020 coverage has grown into a running archive across cricket, football, tennis, and the Olympics — and it's just getting started.</p>
      </div>
      <div class="stat-grid">
        <div class="stat-box"><b>2021</b><span>Founded</span></div>
        <div class="stat-box"><b>65+</b><span>Stories published</span></div>
        <div class="stat-box"><b>4</b><span>Sports covered</span></div>
        <div class="stat-box"><b>1</b><span>Person who started it</span></div>
      </div>
    </div>
  </div>
</section>

<section class="coverage">
  <div class="wrap">
    <div class="section-head">
      <span class="eyebrow"><span class="dot"></span>What we cover</span>
      <h2>Four beats, one newsroom</h2>
    </div>
    <div class="cov-grid">
      <div class="cov-tile"><span class="ic">01</span><h4>Olympics</h4><p>Schedules, medal watches, and every Games since Tokyo 2020.</p></div>
      <div class="cov-tile"><span class="ic">02</span><h4>Cricket</h4><p>T20 World Cup, World Test Championship, squads and fixtures.</p></div>
      <div class="cov-tile"><span class="ic">03</span><h4>Football</h4><p>Transfers, results, and the Champions League run-in.</p></div>
      <div class="cov-tile"><span class="ic">04</span><h4>Tennis</h4><p>Grand Slams and tour results, without the fluff.</p></div>
    </div>
  </div>
</section>

<section class="socials-cta">
  <div class="wrap">
    <h2>Follow along</h2>
    <p>New stories, schedules, and the weekly wrap — find Lightning Sports wherever you already are.</p>
    <div class="social-row">
      <a href="https://twitter.com/TejasKhanna14" target="_blank" rel="noopener noreferrer" aria-label="X / Twitter">𝕏</a>
      <a href="https://facebook.com" target="_blank" rel="noopener noreferrer" aria-label="Facebook">f</a>
      <a href="https://instagram.com" target="_blank" rel="noopener noreferrer" aria-label="Instagram">◎</a>
      <a href="#" target="_blank" rel="noopener noreferrer" aria-label="YouTube">▶</a>
    </div>
  </div>
</section>
</BaseLayout>