---
// src/pages/category/[category]/[tournament].astro
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { categoryType, slugify } from '../../../lib/categoryTypes';

// --- Formatter Helpers ---
const formatTitle = (title: string) => {
  let clean = title.replace(/^["']|["']$/g, '');
  clean = clean.replace(/\b\w/g, (match) => match.toUpperCase());
  const smallWords = ['A', 'An', 'The', 'And', 'But', 'Or', 'For', 'Nor', 'On', 'At', 'To', 'From', 'By', 'With'];
  clean = clean.split(' ').map((word, index) => {
    if (index !== 0 && smallWords.includes(word)) { return word.toLowerCase(); }
    return word;
  }).join(' ');
  return clean;
};

const formatGroupName = (name: string) => {
  return name.replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase());
};

function formatDate(d: Date | string) {
  const date = new Date(d);
  return {
    day: date.toLocaleDateString('en-US', { day: '2-digit' }),
    month: date.toLocaleDateString('en-US', { month: 'short' }).toUpperCase(),
  };
}

// 2. NEW LOGIC: Find the specific sport within a multi-sport event
function getSpecificSport(rawTags: string[] | undefined, category: string, tournament: string): string {
  if (!rawTags) return 'General';
  const ignores = [category.toLowerCase(), tournament.toLowerCase(), 'sports', 'update', 'uncategorized'];
  const sport = rawTags.find((t) => !ignores.includes(t.toLowerCase().trim()));
  return sport ?? 'General Updates';
}

// 3. Build the deep URL paths
// 3. Build the deep URL paths
export async function getStaticPaths() {
  
  // MOVED HERE: Astro needs this inside the function to see it during the build step
  function getSubLabel(rawTags: string[] | undefined, category: string): string | null {
    if (!rawTags) return null;
    const generic = ['sports', 'update', 'announcement', 'uncategorized', category.toLowerCase()];
    const specific = rawTags.find((t) => {
      const lower = t.toLowerCase().trim();
      return lower.length > 0 && !generic.some((g) => lower === g || lower.includes(g));
    });
    return specific ?? null;
  }

  const allPosts = await getCollection('posts');
  const pathMap = new Map();

  for (const p of allPosts) {
    const categoryLabel = p.data.category;
    const catSlug = slugify(categoryLabel);
    const tournamentLabel = getSubLabel(p.data.rawTags, categoryLabel);
    
    if (tournamentLabel) {
      const tourSlug = slugify(tournamentLabel);
      const uniqueKey = `${catSlug}/${tourSlug}`;
      
      if (!pathMap.has(uniqueKey)) {
        pathMap.set(uniqueKey, { 
          category: catSlug, 
          tournament: tourSlug, 
          categoryLabel, 
          tournamentLabel, 
          posts: [] 
        });
      }
      pathMap.get(uniqueKey).posts.push(p);
    }
  }

  return [...pathMap.values()].map((data) => ({
    params: { category: data.category, tournament: data.tournament },
    props: {
      categoryLabel: data.categoryLabel,
      tournamentLabel: data.tournamentLabel,
      posts: data.posts.sort((a: any, b: any) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf()),
    },
  }));
}

const { categoryLabel, tournamentLabel, posts } = Astro.props;
const type = categoryType(categoryLabel);

// Group the remaining posts by individual sport/topic
const sportGroups = new Map<string, any>();
for (const post of posts) {
  const sport = getSpecificSport(post.data.rawTags, categoryLabel, tournamentLabel);
  if (!sportGroups.has(sport)) sportGroups.set(sport, []);
  sportGroups.get(sport)!.push(post);
}

const sortedSportGroups = [...sportGroups.entries()].sort((a: any, b: any) => b[1].length - a[1].length);
---

<BaseLayout title={`${formatGroupName(tournamentLabel)} — Lightning Sports`} description={`Complete coverage of ${tournamentLabel} from Lightning Sports.`}>
<style>
  .hub-head{background:var(--ink); color:var(--chalk); padding:48px 0 40px;}
  .hub-head .eyebrow{color:var(--volt); margin-bottom:16px;}
  .hub-head h1{font-family:var(--font-display); font-weight:400; font-size:clamp(38px,6vw,64px); line-height:1;}
  .hub-head p{color:var(--slate); margin-top:14px; font-size:15px;}

  section{padding:64px 0;}
  .section-label{font-family:var(--font-mono); font-size:11px; letter-spacing:.12em; text-transform:uppercase; color:#5b6472; margin-bottom:10px; display:flex; align-items:center; gap:8px;}
  .section-label::before{content:""; width:16px; height:2px; background:var(--volt);}
  
  .story-list{display:flex; flex-direction:column;}
  .story-row{display:grid; grid-template-columns:90px 1fr; gap:18px; align-items:center; padding:18px 0; border-bottom:1px solid #DEDACB; transition:background .15s ease;}
  .story-row:hover{background:rgba(15,46,34,.03);}
  .date-block{font-family:var(--font-mono); text-align:center; background:var(--ink); color:var(--chalk); border-radius:6px; padding:9px 4px;}
  .date-block .d{font-family:var(--font-display); font-size:18px; color:var(--volt); line-height:1;}
  .date-block .m{font-size:9.5px; letter-spacing:.08em; text-transform:uppercase; margin-top:3px; color:var(--slate);}
  .story-row h3{font-size:16.5px; font-weight:700; line-height:1.35; color: var(--ink);}

  .hidden-post { display: none !important; }
  .story-list.expanded .hidden-post { display: grid !important; }

  /* Premium Inner Groups Grid */
  .groups-band{background:var(--chalk-2); color:var(--ink);}
  .groups-band .section-label{color:var(--scarlet);}
  .groups-band .section-label::before{background:var(--scarlet);}
  
  .group-grid{display:grid; grid-template-columns:repeat(3,1fr); gap:20px;}
  @media (max-width:920px){ .group-grid{grid-template-columns:repeat(2,1fr);} }
  @media (max-width:640px){ .group-grid{grid-template-columns:1fr;} }
  
  .group-card{
    background:#fff;
    border:1px solid #DEDACB;
    border-radius:8px; 
    padding:26px; 
    transition: transform .2s ease, box-shadow .2s ease;
  }
  .group-card:hover{
    transform: translateY(-4px);
    box-shadow: 0 12px 24px -10px rgba(0,0,0,0.1);
    border-color: var(--ink);
  }
  .group-card .ghead{
    display:flex; justify-content:space-between; align-items:baseline; 
    margin-bottom:16px; 
    border-bottom: 1px solid #DEDACB; 
    padding-bottom: 12px;
  }
  .group-card h4{font-family:var(--font-display); font-weight:400; font-size:22px;}
  .group-card .gcount{font-family:var(--font-mono); font-size:11px; color:var(--slate);}
  
  .group-card ul{display:flex; flex-direction:column; gap:0;}
  .group-card li{border-bottom: 1px dashed #EAE7D8;}
  .group-card li:last-child{border-bottom: none;}
  .group-card li a{
    font-size:14px; 
    color:var(--ink); 
    line-height: 1.4; 
    display: block; 
    padding: 12px 0;
  }
  .group-card li a:hover{color:var(--scarlet);}
</style>

<div class="breadcrumb">
  <div class="wrap">
    <a href="/">Home</a><span class="sep">/</span>
    <a href={`/category/${slugify(categoryLabel)}`}>{categoryLabel}</a><span class="sep">/</span>
    <span class="current">{formatGroupName(tournamentLabel)}</span>
  </div>
</div>

<section class="hub-head">
  <div class="wrap">
    <span class="eyebrow"><span class="dot"></span>{categoryLabel} Edition</span>
    <h1>{formatGroupName(tournamentLabel)}</h1>
    <p>Complete coverage of the {formatGroupName(tournamentLabel)}.</p>
  </div>
</section>

<section>
  <div class="wrap">
    <div class="section-label">Latest from {formatGroupName(tournamentLabel)}</div>
    
    <div class="story-list" id="tournamentNewsList">
      {/* FIX 2: Added TypeScript definitions (post: any, index: number) */}
      {posts.map((post: any, index: number) => {
        const { day, month } = formatDate(post.data.date);
        return (
          <a class={`story-row ${index >= 7 ? 'hidden-post' : ''}`} href={`/posts/${post.id}`}>
            <div class="date-block"><div class="d">{day}</div><div class="m">{month}</div></div>
            <div><h3 set:html={formatTitle(post.data.title)}></h3></div>
          </a>
        );
      })}
    </div>
    
    {posts.length > 7 && (
      <div style="text-align: center; margin-top: 32px;">
        <button id="viewMoreTourBtn" style="background: transparent; border: 1px solid var(--inkline); color: var(--ink); padding: 14px 28px; border-radius: 4px; font-family: var(--font-mono); font-size: 12px; font-weight: 600; text-transform: uppercase; cursor: pointer;">
          View all latest news ↓
        </button>
      </div>
    )}
  </div>
</section>

{sortedSportGroups.length > 0 && (
  <section class="groups-band">
    <div class="wrap">
      <div class="section-label">Inside the {type === 'event' ? 'Games' : 'Tournament'}</div>
      <h2 style="font-family: var(--font-display); font-size: 38px; font-weight: 400; margin-bottom: 24px;">Browse by Sport & Topic</h2>
      
      <div class="group-grid">
        {sortedSportGroups.map(([sportName, sportPosts]) => (
          <div class="group-card">
            <div class="ghead">
              <h4>{formatGroupName(sportName)}</h4>
              <span class="gcount">{sportPosts.length} stories</span>
            </div>
            <ul>
              {/* FIX 3: Added TypeScript definition (p: any) */}
              {sportPosts.slice(0, 4).map((p: any) => (
                <li><a href={`/posts/${p.id}`} set:html={formatTitle(p.data.title)}></a></li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>
)}

<script>
  const btn = document.getElementById('viewMoreTourBtn');
  const list = document.getElementById('tournamentNewsList');
  if (btn && list) {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      list.classList.toggle('expanded');
      btn.innerHTML = list.classList.contains('expanded') ? 'Show less ↑' : 'View all latest news ↓';
    });
  }
</script>
</BaseLayout>