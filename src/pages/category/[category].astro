---
// src/pages/category/[category].astro — Sport-themed hub
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { categoryType, slugify } from '../../lib/categoryTypes';
import { themeFor } from '../../lib/themes';

const formatTitle = (title: string) => title.replace(/^["']|["']$/g, '');
const formatGroupName = (name: string) => name.replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase());

function getSubLabel(rawTags: string[] | undefined, category: string): string | null {
  if (!rawTags) return null;
  const generic = ['sports', 'update', 'announcement', 'uncategorized', category.toLowerCase()];
  const specific = rawTags.find((t) => {
    const lower = t.toLowerCase().trim();
    return lower.length > 0 && !generic.some((g) => lower === g || lower.includes(g));
  });
  return specific ?? null;
}

export async function getStaticPaths() {
  const allPosts = await getCollection('posts');
  const bySlug = new Map<string, { label: string; posts: typeof allPosts }>();
  for (const p of allPosts) {
    const categories = Array.isArray(p.data.category) ? p.data.category : [p.data.category];
    for (const catLabel of categories) {
      if (!catLabel) continue;
      const slug = slugify(catLabel);
      if (!bySlug.has(slug)) bySlug.set(slug, { label: catLabel, posts: [] });
      bySlug.get(slug)!.posts.push(p);
    }
  }
  return [...bySlug.entries()].map(([slug, { label, posts }]) => ({
    params: { category: slug },
    props: { label, posts: posts.sort((a: any, b: any) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf()) },
  }));
}

const { label, posts } = Astro.props;
const type = categoryType(label);
const theme = themeFor(label);

const groups = new Map<string, typeof posts>();
for (const post of posts) {
  const sub = getSubLabel(post.data.rawTags, label);
  if (!sub) continue;
  if (!groups.has(sub)) groups.set(sub, []);
  groups.get(sub)!.push(post);
}
const sortedGroups = type === 'event'
  ? [...groups.entries()].sort((a, b) => Math.max(...b[1].map((p) => new Date(p.data.date).valueOf())) - Math.max(...a[1].map((p) => new Date(p.data.date).valueOf())))
  : [...groups.entries()].sort((a, b) => b[1].length - a[1].length);

function fmt(d: Date | string) {
  const date = new Date(d);
  return { day: date.toLocaleDateString('en-US', { day: '2-digit' }), month: date.toLocaleDateString('en-US', { month: 'short' }).toUpperCase() };
}
---
<BaseLayout title={`${label} — Lightning Sports`} description={`Every ${label} story from Lightning Sports.`} sport={label}>
<style>
  .hub-hero {
    position: relative; padding: 60px 0 40px; 
    background: var(--t-gradient), linear-gradient(180deg, var(--t-bg), var(--t-surface));
    overflow: hidden;
  }
  .hub-hero .wrap { position: relative; z-index: 2; }
  .hub-hero .kicker { font-family: var(--font-mono); font-size: 11px; text-transform: uppercase; letter-spacing: .2em; color: var(--t-accent); margin-bottom: 16px; display: inline-flex; align-items: center; gap: 10px; }
  .hub-hero .kicker::before { content:""; width: 40px; height: 1px; background: var(--t-accent); }
  .hub-hero h1 {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(40px, 8vw, 84px);
    line-height: 1.05; letter-spacing: -.02em;
    color: var(--t-ink); margin-bottom: 16px;
  }
  .hub-hero .motto { font-family: var(--font-editorial); font-style: italic; font-size: clamp(18px, 2.2vw, 24px); color: var(--t-ink-muted); margin-bottom: 20px; max-width: 44ch; }
  .hub-hero .count-badge { font-family: var(--font-mono); font-size: 13px; color: var(--t-ink); background: color-mix(in oklab, var(--t-accent) 15%, transparent); border: 1px solid color-mix(in oklab, var(--t-accent) 30%, transparent); padding: 8px 16px; border-radius: 999px; display: inline-block; }

  section.band { padding: 60px 0; }
  .section-label { font-family: var(--font-mono); font-size: 11px; letter-spacing: .16em; text-transform: uppercase; color: var(--t-accent); margin-bottom: 12px; display: flex; align-items: center; gap: 10px; }
  .section-label::before { content: ""; width: 24px; height: 2px; background: var(--t-accent); }
  .section-intro { color: var(--t-ink-muted); font-size: 14.5px; margin-bottom: 30px; max-width: 56ch; }
  h2.big { font-family: var(--font-display); font-weight: 400; font-size: clamp(28px, 4vw, 46px); letter-spacing: -.02em; line-height: 1.02; margin-bottom: 14px; color: var(--t-ink); }
  h2.big em { font-family: var(--font-editorial); font-style: italic; color: var(--t-accent); }

  /* Story list - COMPACTED */
  .story-list { display: flex; flex-direction: column; }
  .story-row { 
    display: grid; grid-template-columns: 70px 1fr auto; gap: 18px; align-items: center; 
    padding: 14px 0; border-bottom: 1px solid var(--t-line); transition: all var(--dur-fast); 
  }
  .story-row:hover { background: color-mix(in oklab, var(--t-accent) 4%, transparent); padding-left: 12px; padding-right: 12px; border-radius: 8px; }
  
  .date-block { text-align: center; padding: 6px 8px; border-radius: 8px; background: var(--t-surface); border: 1px solid var(--t-line); }
  .date-block .d { font-family: var(--font-display); font-size: 18px; color: var(--t-accent); line-height: 1; font-weight: 500; }
  .date-block .m { font-family: var(--font-mono); font-size: 9px; letter-spacing: .1em; color: var(--t-ink-muted); margin-top: 2px; }
  
  .story-row h3 { font-family: var(--font-display); font-weight: 400; font-size: 17px; line-height: 1.3; letter-spacing: -.005em; color: var(--t-ink); }
  .arrow { font-family: var(--font-mono); font-size: 18px; color: var(--t-accent); opacity: 0; transform: translateX(-10px); transition: all var(--dur-fast); }
  .story-row:hover .arrow { opacity: 1; transform: translateX(0); }
  
  .hidden-post { display: none !important; }
  .story-list.expanded .hidden-post { display: grid !important; }
  .empty { padding: 60px 20px; text-align: center; color: var(--t-ink-muted); font-family: var(--font-mono); font-size: 13px; border: 1px dashed var(--t-line); border-radius: 12px; }

  .view-more-btn { background: transparent; border: 1px solid var(--t-line); color: var(--t-ink); padding: 12px 24px; border-radius: 999px; font-family: var(--font-mono); font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: .1em; cursor: pointer; transition: all var(--dur-fast); }
  .view-more-btn:hover { border-color: var(--t-accent); color: var(--t-accent); }

  /* Tournaments/editions band */
  .groups-band { background: var(--t-surface); border-top: 1px solid var(--t-line); border-bottom: 1px solid var(--t-line); }
  .group-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; }
  @media (max-width: 760px) { .group-grid { grid-template-columns: 1fr; } }
  .group-card { border: 1px solid var(--t-line); border-radius: 16px; padding: 26px; background: var(--t-bg); transition: all var(--dur) var(--ease); display: flex; flex-direction: column; }
  .group-card:hover { transform: translateY(-4px); border-color: var(--t-accent); box-shadow: 0 16px 40px -20px var(--t-accent); }
  .group-card .ghead { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 20px; border-bottom: 1px solid var(--t-line); padding-bottom: 14px; }
  .group-card h4 { font-family: var(--font-display); font-weight: 400; font-size: 22px; letter-spacing: -.01em; }
  .group-card h4 a { color: var(--t-ink); transition: color var(--dur-fast); }
  .group-card h4 a:hover { color: var(--t-accent); }
  .group-card .gcount { font-family: var(--font-mono); font-size: 10px; color: var(--t-accent); text-transform: uppercase; letter-spacing: .12em; }
  .group-card ul { display: flex; flex-direction: column; gap:0; padding:0; margin:0;}
  .group-card li { border-bottom: 1px dashed var(--t-line); list-style:none; }
  .group-card li:last-child { border-bottom: none; }
  .group-card li a { font-size: 14px; color: var(--t-ink); line-height: 1.5; display: flex; justify-content: space-between; align-items: center; padding: 12px 0; transition: color var(--dur-fast); }
  .group-card li a::after { content: "→"; opacity: 0; transform: translateX(-10px); transition: all var(--dur-fast); color: var(--t-accent); font-family: var(--font-mono); }
  .group-card li a:hover { color: var(--t-accent); }
  .group-card li a:hover::after { opacity: 1; transform: translateX(0); }
</style>

<div class="breadcrumb"><div class="wrap"><a href="/">Home</a><span class="sep">/</span><a href="/sports">Sports</a><span class="sep">/</span><span class="current">{label}</span></div></div>

<section class="hub-hero">
  <div class="wrap" data-reveal>
    <div class="kicker">{theme.kicker}</div>
    <h1>{label}</h1>
    <p class="motto">{theme.motto}</p>
    <span class="count-badge">◆ {posts.length} {posts.length === 1 ? 'story' : 'stories'} on the desk</span>
  </div>
</section>

<section class="band">
  <div class="wrap">
    <div class="section-label">Latest {label}</div>
    <h2 class="big">The <em>freshest</em> takes</h2>
    <p class="section-intro">
      {type === 'event' ? `The newest ${label} stories, across every edition.` : `The newest ${label} stories, most recent first.`}
    </p>
    {posts.length === 0 ? (
      <div class="empty">No stories in this beat yet — check back soon.</div>
    ) : (
      <>
        <div class="story-list" id="latestNewsList" data-reveal>
          {posts.map((post, index) => {
            const { day, month } = fmt(post.data.date);
            return (
              /* CHANGED: index >= 4 instead of 6 to show fewer initial posts */
              <a class={`story-row ${index >= 4 ? 'hidden-post' : ''}`} href={`/posts/${post.id}`}>
                <div class="date-block"><div class="d">{day}</div><div class="m">{month}</div></div>
                <h3>{formatTitle(post.data.title)}</h3>
                <span class="arrow">→</span>
              </a>
            );
          })}
        </div>
        {/* CHANGED: Show view more button if there are more than 4 posts */}
        {posts.length > 4 && (
          <div style="text-align:center; margin-top:30px;">
            <button id="viewMoreBtn" class="view-more-btn">View all latest ↓</button>
          </div>
        )}
      </>
    )}
  </div>
</section>

{sortedGroups.length > 0 && (
  <section class="band groups-band">
    <div class="wrap">
      <div class="section-label">{type === 'event' ? 'Editions covered' : 'Tournaments covered'}</div>
      <h2 class="big">Explore by <em>{type === 'event' ? 'edition' : 'tournament'}</em></h2>
      <p class="section-intro">
        {type === 'event' ? `Every edition of ${label} we've covered, most recent first.` : `The tournaments driving ${label} coverage, most covered first.`}
      </p>
      <div class="group-grid">
        {sortedGroups.map(([groupName, groupPosts]) => (
          <div class="group-card" data-reveal>
            <div class="ghead">
              <h4><a href={`/category/${slugify(label)}/${slugify(groupName)}`}>{formatGroupName(groupName)}</a></h4>
              <span class="gcount">{groupPosts.length} {groupPosts.length === 1 ? 'story' : 'stories'}</span>
            </div>
            <ul>
              {groupPosts.slice(0, 5).map((p) => (
                <li><a href={`/posts/${p.id}`}>{formatTitle(p.data.title)}</a></li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>
)}

<script>
  const btn = document.getElementById('viewMoreBtn');
  const list = document.getElementById('latestNewsList');
  btn?.addEventListener('click', () => {
    const on = list?.classList.toggle('expanded');
    btn.textContent = on ? 'Show less ↑' : 'View all latest ↓';
  });
</script>
</BaseLayout>