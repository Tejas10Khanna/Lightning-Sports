---
// src/pages/index.astro — Cinematic homepage
  export const prerender = false;
  Astro.response.headers.set('Cache-Control', 'no-cache, no-store, must-revalidate');

  import BaseLayout from '../layouts/BaseLayout.astro';
  import { getCollection } from 'astro:content';
  import { categoryType, slugify } from '../lib/categoryTypes';
  import { themeFor } from '../lib/themes';
  import { kv } from '@vercel/kv';

  const allPosts = await getCollection('posts');
  allPosts.sort((a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf());

  const featured = allPosts[0];
  const secondaryFeatured = allPosts.slice(1, 4);
  const laterFeed = allPosts.slice(4, 10);

  const withViews = await Promise.all(
    allPosts.map(async (p) => {
      let v = 0;
      try { v = (await kv.get<number>(`views:${p.id}`)) || 0; } catch { /* ignore */ }
      return { post: p, v };
    })
  );
  
  const trending = withViews.sort((a, b) => b.v - a.v).slice(0, 4);

  const catCount = new Map<string, number>();
  for (const p of allPosts) {
    const cs = Array.isArray(p.data.category) ? p.data.category : [p.data.category];
    for (const c of cs) if (c && c !== 'Announcement') catCount.set(c, (catCount.get(c) ?? 0) + 1);
  }
  const topSports = [...catCount.entries()].filter(([c]) => categoryType(c) === 'sport').sort((a,b)=>b[1]-a[1]).slice(0, 6);
  const topEvents = [...catCount.entries()].filter(([c]) => categoryType(c) === 'event').sort((a,b)=>b[1]-a[1]).slice(0, 3);

  const fmt = (d: Date | string) => new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
  const cleanTitle = (t: string) => t.replace(/^["']|["']$/g, '');
  const excerpt = (b?: string, n = 180) => (b ? b.replace(/!\[.*?\]\(.*?\)/g, '').replace(/\[(.*?)\]\(.*?\)/g, '$1').replace(/[*_~>#\\]/g, '').replace(/\s+/g,' ').trim().slice(0, n) + '…' : '');
  const firstCat = (p: any) => Array.isArray(p.data.category) ? p.data.category[0] : p.data.category;
---
<BaseLayout title="Lightning Sports — Every field. Every score." sport="global" cinematic={true}>
<style>
  /* ---------- HERO ---------- */
  .hero {
    position: relative; padding: 60px 0 40px;
    min-height: 70vh;
    display: flex; flex-direction: column; justify-content: center;
    background-image: linear-gradient(to right, var(--t-bg) 35%, color-mix(in oklab, var(--t-bg) 50%, transparent) 100%), url('/images/sports/hero-bg1.png');
    background-size: cover;
    background-position: center right;
    background-repeat: no-repeat;
    border-bottom: 1px solid var(--t-line);
  }

  @media (max-width: 768px) {
    .hero {
      background-image: linear-gradient(to top, var(--t-bg) 15%, color-mix(in oklab, var(--t-bg) 70%, transparent) 100%), url('/images/sports/hero-bg-mobile.jpeg');
      background-position: center top;
    }
  }

  .hero .wrap { max-width: 1520px; }

  .hero-grid { position: relative; z-index: 3; display: grid; grid-template-columns: 1.15fr 1fr; gap: 90px; align-items: center; }
  @media (max-width: 960px) { .hero-grid { grid-template-columns: 1fr; gap: 40px; } }

  .hero h1 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(38px, 6vw, 72px);
    line-height: 1.05;
    letter-spacing: -.02em;
    margin: 16px 0 20px;
    color: var(--t-ink);
  }
  .hero h1 em { font-family: var(--font-editorial); font-style: italic; font-weight: 600; color: var(--t-accent); }
  
  .hero .lede { font-size: clamp(16px, 4vw, 18px); color: var(--t-ink-muted); max-width: 50ch; margin-bottom: 24px; line-height: 1.6; }
  .hero-cta { display: flex; gap: 14px; flex-wrap: wrap; }

  .hero-side { 
    background: rgba(0, 0, 0, 0.25); 
    border: 1px solid rgba(255, 255, 255, 0.1); 
    border-radius: 16px; padding: 24px; 
    backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
    min-height: 180px;
  }
  .hero-side h3 { font-family: var(--font-mono); font-size: 11px; text-transform: uppercase; color: var(--t-accent); margin-bottom: 20px; display: flex; align-items: center; gap: 10px; }
  .hero-side h3::before {
    content: ""; display: block; width: 8px; height: 8px; border-radius: 50%;
    background: #FF3B3B;
    box-shadow: 0 0 0 0 rgba(255, 59, 59, 0.7);
    animation: pulse-dot 1.5s infinite cubic-bezier(0.66, 0, 0, 1);
  }
  @keyframes pulse-dot { to { box-shadow: 0 0 0 12px rgba(255, 59, 59, 0); } }

  .ticker-stage { position: relative; min-height: 100px; }
  .ticker-item {
    position: absolute; inset: 0;
    padding: 14px 16px; border: 1px solid var(--t-line); border-radius: 10px;
    background: rgba(0,0,0,0.1);
    opacity: 0; transform: translateX(28px);
    transition: opacity 500ms var(--ease), transform 500ms var(--ease);
    pointer-events: none;
  }
  .ticker-item.active { opacity: 1; transform: translateX(0); pointer-events: auto; }
  .ticker-item.leaving { opacity: 0; transform: translateX(-28px); }
  .ticker-item:hover { border-color: var(--t-accent); background: color-mix(in oklab, var(--t-accent) 8%, transparent); }
  .ticker-item .cat { font-family: var(--font-mono); font-size: 10px; color: var(--t-accent); text-transform: uppercase; letter-spacing: 0.05em; }
  .ticker-item .ttl { 
    font-size: 15px; font-weight: 500; color: var(--t-ink); margin-top: 6px; line-height: 1.4; 
    display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;
  }
  @media (prefers-reduced-motion: reduce) { .ticker-item { transition: none; } }

  .ticker { border-top: 1px solid var(--t-line); border-bottom: 1px solid var(--t-line); background: var(--t-surface); overflow: hidden; padding: 12px 0; }
  .ticker-track { display: flex; white-space: nowrap; animation: scroll-left 60s linear infinite; gap: 40px; }
  .ticker-track span.item { font-family: var(--font-mono); font-size: 13px; color: var(--t-ink-muted); }
  .ticker-track span.item b { color: var(--t-accent); margin-right: 10px; }
  @keyframes scroll-left { from { transform: translateX(0); } to { transform: translateX(-50%); } }

  /* ---------- SECTIONS ---------- */
  section.band { padding: 60px 0; }
  
  /* FIX: Prevents the Subheadings from squeezing into awkward tall columns */
  .head-row { display: flex; align-items: flex-end; justify-content: space-between; gap: 20px; margin-bottom: 30px; }
  @media (max-width: 768px) {
    .head-row { flex-direction: column; align-items: flex-start; gap: 14px; }
  }

  .head-row h2 { font-family: var(--font-display); font-size: clamp(32px, 5vw, 46px); color: var(--t-ink); line-height: 1.1; }
  .head-row h2 em { font-family: var(--font-editorial); font-style: italic; font-weight: 600; color: var(--t-accent); }
  .head-note { color: var(--t-ink-muted); font-size: clamp(14px, 3.5vw, 16px); }

  .featured-spread { display: grid; grid-template-columns: 1.2fr 1fr; gap: 30px; }
  @media (max-width: 920px) { .featured-spread { grid-template-columns: 1fr; } }

  .lead-card {
    padding: 24px; border: 1px solid var(--t-line); border-radius: 16px;
    background: var(--t-surface); transition: all var(--dur-fast);
    display: flex; flex-direction: column; justify-content: center;
  }
  .lead-card:hover { border-color: var(--t-accent); box-shadow: 0 16px 40px -20px var(--t-accent); transform: translateY(-4px); }
  .lead-card .tag { font-family: var(--font-mono); font-size: 11px; text-transform: uppercase; color: var(--t-accent); margin-bottom: 12px; display: inline-block; }
  .lead-card h3 { font-family: var(--font-display); font-size: clamp(26px, 4vw, 42px); color: var(--t-ink); margin-bottom: 16px; line-height: 1.1; }
  .lead-card p.dek { font-size: 18px; color: var(--t-ink-muted); line-height: 1.5; margin-bottom: 24px; }
  .lead-card .meta { display: flex; gap: 16px; margin-top: auto; padding-top: 16px; border-top: 1px solid var(--t-line); font-family: var(--font-mono); font-size: 11px; color: var(--t-ink-muted); }

  .secondary-stack { display: flex; flex-direction: column; gap: 12px; }
  .sec-card { padding: 16px; border: 1px solid var(--t-line); border-radius: 12px; background: var(--t-surface); transition: all var(--dur-fast); }
  .sec-card:hover { border-color: var(--t-accent); transform: translateX(-4px); box-shadow: -4px 0 0 var(--t-accent); background: color-mix(in oklab, var(--t-accent) 6%, transparent); }
  .sec-card .tag { font-family: var(--font-mono); font-size: 10px; color: var(--t-accent); text-transform: uppercase; }
  .sec-card h4 { font-family: var(--font-display); font-size: 18px; margin: 6px 0; color: var(--t-ink); }
  
  /* FIX: Horizontal scroll with exact peeking pixel math */
  @media (max-width: 920px) {
    .secondary-stack { flex-direction: row; overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: 12px; scrollbar-width: none; gap: 16px; scroll-padding-left: 0; }
    .secondary-stack::-webkit-scrollbar { display: none; }
    .sec-card { flex: 0 0 calc(100% - 48px); scroll-snap-align: start; }
  }

  .feed-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .feed-card { padding: 20px; border: 1px solid var(--t-line); border-radius: 12px; display: flex; flex-direction: column; background: var(--t-surface); transition: all var(--dur-fast); }
  .feed-card:hover { border-color: var(--t-accent); transform: translateY(-4px); box-shadow: 0 12px 30px -15px var(--t-accent); }
  .feed-card h3 { font-family: var(--font-display); font-size: 20px; margin: 10px 0; color: var(--t-ink); }
  .feed-card .tag { font-family: var(--font-mono); font-size: 10px; text-transform: uppercase; color: var(--t-accent); }

  /* FIX: Horizontal scroll with exact peeking pixel math */
  @media (max-width: 760px) { 
    .feed-grid { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: 16px; scrollbar-width: none; gap: 16px; scroll-padding-left: 0; }
    .feed-grid::-webkit-scrollbar { display: none; }
    .feed-card { flex: 0 0 calc(100% - 48px); scroll-snap-align: start; }
  }

  /* ---------- SPORTS GALLERY ---------- */
  .gallery-group { margin-bottom: 48px; }
  .gallery-group h3.sub-lbl { font-family: var(--font-mono); font-size: 12px; letter-spacing: .16em; text-transform: uppercase; color: var(--t-ink-muted); margin-bottom: 16px; }
  .gallery-row { position: relative; }
  .sports-gallery {
    display: flex; gap: 16px; overflow-x: auto; scroll-snap-type: x mandatory;
    scrollbar-width: none; padding-bottom: 4px;
  }
  .sports-gallery::-webkit-scrollbar { display: none; }

  .sport-tile {
    flex: 0 0 300px; scroll-snap-align: start;
    aspect-ratio: 16 / 9;
    border-radius: 16px; border: 1px solid var(--t-line);
    padding: 24px; position: relative; overflow: hidden;
    display: flex; flex-direction: column; justify-content: flex-end;
    transition: all var(--dur) var(--ease);
    background: var(--t-surface);
    background-size: cover; background-position: center;
  }
  .sport-tile:hover { transform: translateY(-6px); border-color: var(--t-accent); box-shadow: 0 16px 30px -10px var(--t-accent); }

  @media (max-width: 640px) {
    .sport-tile { flex: 0 0 calc(100% - 48px); }
  }

  .gallery-arrow {
    position: absolute; right: 24px; bottom: 24px;
    font-family: var(--font-mono); font-size: 20px;
    color: var(--t-accent); opacity: 0;
    transform: translateX(-10px);
    transition: all var(--dur-fast);
  }
  .sport-tile:hover .gallery-arrow { opacity: 1; transform: translateX(0); }

  .sport-tile h3 { font-family: var(--font-display); font-weight: 400; font-size: 24px; color: var(--t-ink); }
  .sport-tile .idx { font-family: var(--font-mono); font-size: 10px; letter-spacing: .2em; text-transform: uppercase; color: var(--t-ink-muted); margin-bottom: 8px; }

  .gallery-nav {
    position: absolute; top: 50%; transform: translateY(-50%);
    width: 42px; height: 42px; border-radius: 50%;
    background: color-mix(in oklab, var(--t-bg) 85%, transparent);
    border: 1px solid var(--t-line); color: var(--t-ink);
    display: flex; align-items: center; justify-content: center;
    font-family: var(--font-mono); font-size: 16px; z-index: 5;
    transition: all var(--dur-fast);
  }
  .gallery-nav:hover { border-color: var(--t-accent); color: var(--t-accent); }
  .gallery-nav.prev { left: -21px; }
  .gallery-nav.next { right: -21px; }
  @media (max-width: 640px) { .gallery-nav { display: none; } }

  /* ---------- NEWSLETTER ---------- */
  .cadence label input { display: none; }
  .cadence label span:first-of-type {
    width: 18px; height: 18px; border: 1px solid var(--t-line);
    border-radius: 4px; display: inline-flex; align-items: center; justify-content: center;
    transition: all var(--dur-fast);
  }
  .cadence input:checked + span:first-of-type { background: var(--t-accent); border-color: var(--t-accent); }
  .cadence input:checked + span:first-of-type::after {
    content: "✓"; color: var(--t-bg); font-size: 12px; font-weight: bold;
  }
  .other-sport-input {
    width: 100%; margin-top: 8px; background: var(--t-bg);
    border: 1px dashed var(--t-line); padding: 8px; border-radius: 8px;
    color: var(--t-ink); font-family: var(--font-mono); font-size: 11px;
  }
  .newsletter-panel {
    padding: 60px; border-radius: 32px; position: relative; overflow: hidden;
    background: linear-gradient(135deg, color-mix(in oklab, var(--t-accent) 12%, var(--t-surface)), var(--t-surface));
    border: 1px solid var(--t-line);
  }
  @media (max-width: 720px) { .newsletter-panel { padding: 36px 24px; border-radius: 20px; } }
  .newsletter-panel::before {
    content:""; position:absolute; top:-40%; right:-20%; width: 60%; height: 180%;
    background: radial-gradient(ellipse, color-mix(in oklab, var(--t-accent) 25%, transparent), transparent 60%);
    filter: blur(90px); pointer-events: none;
  }
  .newsletter-inner { position: relative; z-index: 2; display: grid; grid-template-columns: 1fr 1fr; gap: 50px; align-items: flex-start; }
  @media (max-width: 820px) { .newsletter-inner { grid-template-columns: 1fr; } }
  .newsletter-inner h2 { font-family: var(--font-display); font-weight: 400; font-size: clamp(30px, 4.5vw, 52px); letter-spacing: -.02em; line-height: 1.02; margin-bottom: 16px; }
  .newsletter-inner h2 em { font-family: var(--font-editorial); font-style: italic; font-weight: 600; color: var(--t-accent); }
  .newsletter-inner p { color: var(--t-ink-muted); font-size: 15px; line-height: 1.7; max-width: 40ch; }

  form.sub-form { display: flex; flex-direction: column; gap: 14px; }
  .field-input {
    display: flex; background: var(--t-bg); border: 1px solid var(--t-line);
    border-radius: 999px; overflow: hidden; transition: border-color var(--dur-fast);
  }
  .field-input:focus-within { border-color: var(--t-accent); }
  .field-input input { flex: 1; background: transparent; border: 0; color: var(--t-ink); padding: 16px 22px; font-family: var(--font-mono); font-size: 14px; outline: none; }
  .field-input input::placeholder { color: var(--t-ink-muted); }
  .field-input button { background: var(--t-accent); color: var(--t-bg); padding: 0 26px; font-family: var(--font-mono); font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: .1em; }
  @media (max-width: 540px) { .field-input { flex-direction: column; border-radius: 14px; padding: 6px; gap: 6px; } .field-input input { border-radius: 10px; } .field-input button { border-radius: 10px; padding: 14px; } }

  .sport-chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .chip { padding: 8px 14px; font-family: var(--font-mono); font-size: 11px; text-transform: uppercase; letter-spacing: .1em; border: 1px solid var(--t-line); border-radius: 999px; cursor: pointer; transition: all var(--dur-fast); background: transparent; color: var(--t-ink); }
  .chip:hover { border-color: var(--t-accent); color: var(--t-accent); }
  .chip.on { background: var(--t-accent); color: var(--t-bg); border-color: var(--t-accent); }
  .chip-label { font-family: var(--font-mono); font-size: 10.5px; text-transform: uppercase; letter-spacing: .16em; color: var(--t-ink-muted); margin-bottom: 10px; display: block; }

  .cadence { display: flex; gap: 8px; margin-bottom: 8px; }
  .cadence label { flex: 1; padding: 14px; border: 1px solid var(--t-line); border-radius: 12px; cursor: pointer; display: flex; align-items: flex-start; gap: 10px; transition: all var(--dur-fast); }
  .cadence label:has(input:checked) { border-color: var(--t-accent); background: color-mix(in oklab, var(--t-accent) 8%, transparent); }
  .cadence .t-title { display: block; font-weight: 600; font-size: 13px; color: var(--t-ink); margin-bottom: 4px; }
  .cadence .t-desc { display: block; font-size: 12px; color: var(--t-ink-muted); line-height: 1.5; }

  .sub-note { font-size: 13px; color: var(--t-ink-muted); line-height: 1.5; }
  .sub-status { font-family: var(--font-mono); font-size: 12px; margin-top: 4px; min-height: 18px; }
  .sub-status.ok { color: var(--t-accent-2); }
  .sub-status.err { color: var(--t-pop); }
</style>

<!-- ================== HERO ================== -->
<section class="hero">
  <div class="wrap hero-grid">
    <div data-reveal>
      <span class="eyebrow"><span class="dot"></span>Live at the desk, {new Date().toLocaleDateString('en-US',{weekday:'long'})}</span>
      <h1>One place.<br />Every field.<br /><em>Every score.</em></h1>
      <p class="lede">The sports newsroom that reads like a magazine — cricket, football, tennis, F1, and every Olympic flame in between. Reported fast, written sharp, coloured by the beat itself.</p>
      <div class="hero-cta">
        <a href="#latest" class="btn btn-primary">Read the latest →</a>
        <a href="#subscribe" class="btn btn-ghost">Get the newsletter</a>
      </div>
    </div>
    <aside class="hero-side" data-reveal aria-label="Trending stories" id="trendPanel">
      <h3>Trending right now</h3>
      <div class="ticker-stage" id="tickerStage">
        {trending.map(({post}, i) => (
          <a class={`ticker-item ${i === 0 ? 'active' : ''}`} href={`/posts/${post.id}`} data-idx={i}>
            <div class="cat">{firstCat(post)}</div>
            <div class="ttl">{cleanTitle(post.data.title)}</div>
          </a>
        ))}
      </div>
    </aside>
  </div>
</section>

<!-- ================== TICKER ================== -->
<div class="ticker" aria-label="Headline ticker">
  <div class="ticker-track">
    {[...allPosts.slice(0,10), ...allPosts.slice(0,10)].map((post) => (
      <span class="item"><b>◆ {firstCat(post)}</b><em>{cleanTitle(post.data.title)}</em></span>
    ))}
  </div>
</div>

<!-- ================== FEATURED ================== -->
<section class="band" id="latest">
  <div class="wrap">
    <div class="head-row" data-reveal>
      <div>
        <span class="eyebrow"><span class="dot"></span>From the desk</span>
        <h2 style="margin-top:14px;">The <em>lead</em> story</h2>
      </div>
      <p class="head-note">One story we couldn't put down. Everything else follows below.</p>
    </div>

    {featured && (
      <div class="featured-spread" data-reveal aria-label={`Featured: ${featured.data.title}`}>
        <a href={`/posts/${featured.id}`} class="lead-card">
          <div>
            <span class="tag">{firstCat(featured)}</span>
            <h3>{cleanTitle(featured.data.title)}</h3>
            <p class="dek">{featured.data.dek || excerpt(featured.body, 220)}</p>
          </div>
          <div class="meta">
            <span>By {featured.data.author}</span>
            <span>{fmt(featured.data.date)}</span>
          </div>
        </a>

        <div class="secondary-stack">
          {secondaryFeatured.map((p) => (
            <a href={`/posts/${p.id}`} class="sec-card">
              <span class="tag">{firstCat(p)}</span>
              <h4>{cleanTitle(p.data.title)}</h4>
              <span class="date" style="font-family: var(--font-mono); font-size: 11px; color: var(--t-ink-muted);">{fmt(p.data.date)}</span>
            </a>
          ))}
        </div>
      </div>
    )}
  </div>
</section>

<!-- ================== FEED ================== -->
{laterFeed.length > 0 && (
  <section class="band" style="padding-top: 40px;">
    <div class="wrap">
      <div class="head-row" data-reveal>
        <div>
          <span class="eyebrow"><span class="dot"></span>All this week</span>
          <h2>What <em>else</em> broke</h2>
        </div>
        <p class="head-note">Straight-talking recaps and schedules, filed the moment the whistle blows.</p>
      </div>
      <div class="feed-grid">
        {laterFeed.map((p) => (
          <a class="feed-card" href={`/posts/${p.id}`} data-reveal>
            <span class="tag">{firstCat(p)}</span>
            <h3>{cleanTitle(p.data.title)}</h3>
            <div style="margin-top: auto; padding-top: 16px; display: flex; justify-content: space-between; font-family: var(--font-mono); font-size: 11px; color: var(--t-ink-muted);">
              <span>{fmt(p.data.date)}</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
)}

<!-- ================== SPORTS GALLERY — SPLIT SECTIONS ================== -->
<section class="band">
  <div class="wrap">
    <div class="head-row" data-reveal>
      <div>
        <span class="eyebrow"><span class="dot"></span>Beats we cover</span>
        <h2>Pick your <em>sport</em></h2>
      </div>
      <p class="head-note" style="max-width: 40ch;">Continuous coverage of the sports that matter, and the global events where they collide.</p>
    </div>

    <!-- Sports Track -->
    <div class="gallery-group">
      <h3 class="sub-lbl">Continuous Coverage</h3>
      <div class="gallery-row">
        <button class="gallery-nav prev" id="sportsPrev" aria-label="Scroll left">←</button>
        <div class="sports-gallery" id="sportsTrack">
          {topSports.map(([cat, count], i) => {
            const t = themeFor(cat);
            const bgImage = `/images/sports/${slugify(cat)}.png`;
            return (
              <a class="sport-tile"
                 data-key={t.key}
                 href={`/category/${slugify(cat)}`}
                 aria-label={`${cat}, ${count} stories`}
                 style={`background-image: linear-gradient(to top, rgba(15, 20, 25, 0.95) 10%, rgba(15, 20, 25, 0.2) 80%), url('${bgImage}');`}
              >
                <span class="idx">{String(i+1).padStart(2,'0')} / BEAT</span>
                <div>
                  <h3>{cat}</h3>
                  <div style="font-family: var(--font-mono); font-size: 11px; color: var(--t-accent); margin-top: 8px;">
                    {count} {count === 1 ? 'story' : 'stories'}
                  </div>
                </div>
                <span class="gallery-arrow">→</span>
              </a>
            );
          })}
        </div>
        <button class="gallery-nav next" id="sportsNext" aria-label="Scroll right">→</button>
      </div>
    </div>

    <!-- Events Track -->
    {topEvents.length > 0 && (
      <div class="gallery-group">
        <h3 class="sub-lbl">Multi-sport events</h3>
        <div class="gallery-row">
          <button class="gallery-nav prev" id="eventsPrev" aria-label="Scroll left">←</button>
          <div class="sports-gallery" id="eventsTrack">
            {topEvents.map(([cat, count], i) => {
              const t = themeFor(cat);
              const bgImage = `/images/sports/${slugify(cat)}.png`;
              return (
                <a class="sport-tile"
                   data-key={t.key}
                   href={`/category/${slugify(cat)}`}
                   aria-label={`${cat}, ${count} stories`}
                   style={`background-image: linear-gradient(to top, rgba(15, 20, 25, 0.95) 10%, rgba(15, 20, 25, 0.2) 80%), url('${bgImage}');`}
                >
                  <span class="idx">{String(i+1).padStart(2,'0')} / EVENT</span>
                  <div>
                    <h3>{cat}</h3>
                    <div style="font-family: var(--font-mono); font-size: 11px; color: var(--t-accent); margin-top: 8px;">
                      {count} {count === 1 ? 'story' : 'stories'}
                    </div>
                  </div>
                  <span class="gallery-arrow">→</span>
                </a>
              );
            })}
          </div>
          <button class="gallery-nav next" id="eventsNext" aria-label="Scroll right">→</button>
        </div>
      </div>
    )}

  </div>
</section>

<!-- ================== NEWSLETTER ================== -->
<section class="band" id="subscribe">
  <div class="wrap">
    <div class="newsletter-panel" data-reveal style="padding: 48px;">
      <div class="newsletter-inner" style="gap: 60px; align-items: flex-start;">
        <div>
          <span class="eyebrow"><span class="dot"></span>Free — always</span>
          <h2 style="margin-top:16px;">The desk, in <em>your</em> inbox.</h2>
          <p style="margin-bottom:24px; color: var(--t-ink-muted); font-size: 15px; line-height: 1.6; max-width: 40ch;">We're earning your trust before we ever ask for anything. Pick one option or both — it costs nothing either way.</p>
          <div style="display: flex; gap: 20px; font-family: var(--font-mono); font-size: 13px; font-weight: 600;">
            <a href="https://api.whatsapp.com/send?phone=919555039015" target="_blank" style="color: #25D366; text-decoration: none;">💬 WhatsApp</a>
            <a href="https://instagram.com/" target="_blank" style="color: #E1306C; text-decoration: none;">📸 Instagram</a>
          </div>
        </div>

        <form id="subForm" class="sub-form" style="display: flex; flex-direction: column; gap: 16px;">
          <div class="cadence" style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
            <label style="padding: 16px; align-items: center; border: 1px solid var(--t-line); border-radius: 12px; cursor: pointer; display: flex; gap: 12px; background: color-mix(in oklab, var(--t-bg) 50%, transparent);">
              <input type="checkbox" name="alerts" checked/><span></span>
              <span class="t-title" style="font-size: 14px; font-weight: 700;">Story Alerts</span>
            </label>
            <label style="padding: 16px; align-items: center; border: 1px solid var(--t-line); border-radius: 12px; cursor: pointer; display: flex; gap: 12px; background: color-mix(in oklab, var(--t-bg) 50%, transparent);">
              <input type="checkbox" name="weekly" checked/><span></span>
              <span class="t-title" style="font-size: 14px; font-weight: 700;">Weekly Wrap</span>
            </label>
          </div>

          <div>
            <span class="chip-label" style="margin-bottom: 10px;">Sports you follow</span>
            <div class="sport-chips" style="margin-bottom: 8px;">
              {['Cricket','Football','Tennis','Olympics','F1'].map((s) => (
                <button type="button" class="chip" data-sport={s} style="padding: 8px 16px; font-size: 11px;">{s}</button>
              ))}
            </div>
            <input type="text" id="otherSport" class="other-sport-input" placeholder="Other sports (comma separated)..." style="width: 100%; padding: 12px; font-size: 12px;" />
          </div>

          <div class="field-input">
            <input type="email" name="email" placeholder="Email address" required />
            <button type="submit">Subscribe</button>
          </div>

          <p style="font-size: 12px; color: var(--t-ink-muted); line-height: 1.6; margin-top: 4px; border-top: 1px dashed var(--t-line); padding-top: 12px; width: 100%;">
            🔒 Free for as long as you're subscribed. If we ever add a premium tier down the line, early subscribers keep their free access — no bait and switch.
          </p>
          <div id="subStatus" class="sub-status"></div>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  // ---- Trending crossfade — dynamically faster on mobile ----
  const stage = document.getElementById('tickerStage');
  if (stage) {
    const items = Array.from(stage.querySelectorAll('.ticker-item'));
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const isMobile = window.matchMedia('(max-width: 768px)').matches;
    let current = 0;
    let timer: ReturnType<typeof setInterval> | null = null;

    function advance() {
      if (items.length < 2) return;
      const next = (current + 1) % items.length;
      items[current].classList.add('leaving');
      items[current].classList.remove('active');
      items[next].classList.add('active');
      setTimeout(() => items[current].classList.remove('leaving'), 500);
      current = next;
    }
    
    function start() { 
      if (!reduced && items.length > 1) {
        timer = setInterval(advance, isMobile ? 1500 : 2500); 
      }
    }
    function stop() { if (timer) clearInterval(timer); }

    start();
    const panel = document.getElementById('trendPanel');
    panel?.addEventListener('mouseenter', stop);
    panel?.addEventListener('mouseleave', start);
  }

  // ---- Separated Sports/Events gallery arrow scroll ----
  const setupScroll = (trackId: string, prevId: string, nextId: string) => {
    const track = document.getElementById(trackId);
    document.getElementById(prevId)?.addEventListener('click', () => track?.scrollBy({ left: -330, behavior: 'smooth' }));
    document.getElementById(nextId)?.addEventListener('click', () => track?.scrollBy({ left: 330, behavior: 'smooth' }));
  };
  setupScroll('sportsTrack', 'sportsPrev', 'sportsNext');
  setupScroll('eventsTrack', 'eventsPrev', 'eventsNext');

  // ---- Newsletter ----
  const chosen = new Set<string>();
  document.querySelectorAll<HTMLButtonElement>('.chip').forEach((c) => {
    c.addEventListener('click', () => {
      const s = c.dataset.sport!;
      if (chosen.has(s)) { chosen.delete(s); c.classList.remove('on'); }
      else { chosen.add(s); c.classList.add('on'); }
    });
  });

  const form = document.getElementById('subForm') as HTMLFormElement;
  const otherInput = document.getElementById('otherSport') as HTMLInputElement;
  const status = document.getElementById('subStatus')!;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const fd = new FormData(form);
    const otherSports = otherInput.value.split(',').map(s => s.trim()).filter(Boolean);
    const payload = {
      email: fd.get('email'),
      alerts: fd.get('alerts') === 'on',
      weekly: fd.get('weekly') === 'on',
      sports: [...chosen, ...otherSports],
    };
    status.textContent = 'Sending…'; status.className = 'sub-status';
    try {
      const r = await fetch('/api/subscribe', {
        method: 'POST',
        headers: {'Content-Type':'application/json'},
        body: JSON.stringify(payload)
      });
      if (r.ok) {
        status.textContent = "You're in. Check your inbox."; status.className = 'sub-status ok';
        form.reset(); chosen.clear(); otherInput.value = '';
        document.querySelectorAll('.chip').forEach(c => c.classList.remove('on'));
      }
    } catch { status.textContent = 'Error — try again.'; }
  });
</script>
</BaseLayout>