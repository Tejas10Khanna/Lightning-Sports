---
export const prerender = false; // Ensures the page is dynamic
Astro.response.headers.set('Cache-Control', 'no-cache, no-store, must-revalidate'); // Busters the CDN cache

import { categoryType } from '../lib/categoryTypes';
import BaseLayout from '../layouts/BaseLayout.astro';
import { kv } from '@vercel/kv';
import { getCollection } from 'astro:content';

// 1. Fetch posts from local markdown collection
const allPosts = await getCollection('posts');

// 2. Sort posts by date (Newest to Oldest) for the latest block
allPosts.sort((a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf());

// 3. Grab exactly 5 posts to perfectly fill the 1 feature + 4 normal grid
const latestPosts = allPosts.slice(0, 5);

// 3b. Real-time Trending Posts — reads real view counts from Vercel KV dynamically
const postsWithViews = await Promise.all(
  allPosts.map(async (post) => {
    let views = 0;
    try {
      views = (await kv.get<number>(`views:${post.id}`)) || 0;
    } catch {
      // KV unavailable — degrade gracefully, don't take the page down
    }
    return { ...post, views };
  })
);

// CHANGED: Named this 'topViewedPosts' so your HTML template below maps it perfectly
const topViewedPosts = postsWithViews
  .sort((a, b) => b.views - a.views)
  .slice(0, 4);

// 3c. Real "Pick your sport" data — separated by type
const categoryCounts = new Map<string, number>();
for (const p of allPosts) {
  // Safely grab the array of categories
  const categories = Array.isArray(p.data.category) ? p.data.category : [p.data.category];
  
  for (const cat of categories) {
    if (cat && cat !== 'Announcement') {
      categoryCounts.set(cat, (categoryCounts.get(cat) ?? 0) + 1);
    }
  }
}

// Grab top 4 continuous sports
const topSports = [...categoryCounts.entries()]
  .filter(([cat]) => categoryType(cat) === 'sport')
  .sort((a, b) => b[1] - a[1])
  .slice(0, 4);

// Grab top 2 events
const topEvents = [...categoryCounts.entries()]
  .filter(([cat]) => categoryType(cat) === 'event')
  .sort((a, b) => b[1] - a[1])
  .slice(0, 2);

const categoryLabel = (cat: string) =>
  cat.replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase());

// 4. Helper to format date cleanly
const formatDate = (date: Date | string) =>
  new Date(date).toLocaleDateString('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
  });
  
// Upgraded Helper to strip quotes and force perfect Title Case
const formatTitle = (title: string) => {
  let clean = title.replace(/^["']|["']$/g, '');
  clean = clean.replace(/\b\w/g, (match) => match.toUpperCase());
  const smallWords = ['A', 'An', 'The', 'And', 'But', 'Or', 'For', 'Nor', 'On', 'At', 'To', 'From', 'By', 'With'];
  clean = clean.split(' ').map((word, index) => {
    if (index !== 0 && smallWords.includes(word)) {
      return word.toLowerCase();
    }
    return word;
  }).join(' ');
  return clean;
};

// Updated Excerpt Cleaner (now allows custom lengths)
const generateCleanExcerpt = (body?: string, length: number = 150) => {
  if (!body) return '';
  return body
    .replace(/!\[.*?\]\(.*?\)/g, '') 
    .replace(/\[(.*?)\]\(.*?\)/g, '$1') 
    .replace(/[*_~>#\\]/g, '') 
    .replace(/\s+/g, ' ') 
    .trim()
    .substring(0, length) + '...';
};
---

<BaseLayout title="Lightning Sports — One place for all your sports news">
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="description" content="Lightning Sports: fast, sharp coverage of cricket, football, tennis and the Olympics.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Anton&family=Inter:wght@400;500;600;700;800&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">

<style>
  :root{
    --ink:#0B1220;
    --ink-2:#111B2C;
    --inkline:#22314A;
    --pitch:#0F2E22;
    --pitch-line:#1E4635;
    --chalk:#F3F1E7;
    --chalk-2:#EAE7D8;
    --volt:#F2A63D;
    --scarlet:#FF4438;
    --slate:#8B97A6;
    --ink-soft:#0d1524;
    --font-display:'Anton', sans-serif;
    --font-body:'Inter', sans-serif;
    --font-mono:'IBM Plex Mono', monospace;
  }
  *{box-sizing:border-box; margin:0; padding:0;}
  html{scroll-behavior:smooth;}
  body{
    font-family:var(--font-body);
    background:var(--chalk);
    color:var(--ink);
    line-height:1.5;
    -webkit-font-smoothing:antialiased;
  }
  a{color:inherit; text-decoration:none;}
  img{max-width:100%; display:block;}
  ul{list-style:none;}
  .wrap{max-width:1180px; margin:0 auto; padding:0 28px;}
  :focus-visible{outline:3px solid var(--volt); outline-offset:2px;}

  /* ---------- eyebrow / label ---------- */
  .eyebrow{
    font-family:var(--font-mono);
    font-size:12px;
    letter-spacing:.14em;
    text-transform:uppercase;
    display:inline-flex;
    align-items:center;
    gap:8px;
  }
  .eyebrow .dot{
    width:7px; height:7px; border-radius:50%;
    background:var(--scarlet);
    box-shadow:0 0 0 0 rgba(255,68,56,.6);
    animation:pulse 1.8s infinite;
  }
  @keyframes pulse{
    0%{box-shadow:0 0 0 0 rgba(255,68,56,.55);}
    70%{box-shadow:0 0 0 8px rgba(255,68,56,0);}
    100%{box-shadow:0 0 0 0 rgba(255,68,56,0);}
  }

  /* ---------- header ---------- */
  header{
    position:sticky; top:0; z-index:100;
    background:var(--ink);
    border-bottom:1px solid var(--inkline);
  }
  .nav-row{
    display:flex; align-items:center; justify-content:space-between;
    height:76px;
  }
  .brand{display:flex; align-items:center; gap:12px;}
  .bolt{
    width:26px; height:34px; flex:none;
  }
  .bolt path{fill:var(--volt);}
  .brand-text{color:var(--chalk); font-family:var(--font-display); font-size:20px; letter-spacing:.03em; line-height:1;}
  .brand-text span{display:block; font-family:var(--font-mono); font-size:10px; color:var(--slate); letter-spacing:.16em; text-transform:uppercase; margin-top:4px; font-weight:500;}

  nav.primary{display:flex; align-items:center; gap:2px;}
  nav.primary > ul{display:flex; align-items:center;}
  nav.primary a.top-link{
    color:var(--chalk); font-size:14px; font-weight:600;
    padding:10px 16px; display:block; border-radius:4px;
    transition:color .15s ease;
  }
  nav.primary li{position:relative;}
  nav.primary a.top-link:hover{color:var(--volt);}
  .has-sub:hover .submenu, .has-sub:focus-within .submenu{display:block;}
  .submenu{
    display:none; position:absolute; top:100%; left:12px;
    background:var(--ink-2); border:1px solid var(--inkline);
    min-width:220px; padding:6px; border-radius:6px;
  }
  .submenu a{
    display:block; padding:9px 12px; font-size:13px; color:var(--slate);
    font-family:var(--font-mono); border-radius:4px;
  }
  .submenu a:hover{background:var(--inkline); color:var(--chalk);}
  .join-btn{
    background:var(--volt); color:var(--ink) !important;
    padding:9px 18px !important; border-radius:3px;
    font-family:var(--font-mono); text-transform:uppercase; font-size:12px !important;
    letter-spacing:.08em; font-weight:600 !important;
  }
  .menu-toggle{display:none; background:none; border:1px solid var(--inkline); color:var(--chalk); width:40px; height:40px; border-radius:4px; font-size:18px;}

  @media (max-width:920px){
    nav.primary > ul{
      display:none;
      position:absolute; top:76px; left:0; right:0;
      background:var(--ink); border-bottom:1px solid var(--inkline);
      flex-direction:column; align-items:stretch; padding:8px 20px 20px;
    }
    nav.primary > ul.open{display:flex;}
    nav.primary a.top-link{padding:12px 4px; border-bottom:1px solid var(--ink-2);}
    .submenu{position:static; display:block; border:none; background:none; padding:0 0 0 14px;}
    .has-sub .submenu{display:block;}
    .menu-toggle{display:block;}
    .join-btn{margin-top:8px; text-align:center;}
  }

  /* ---------- hero ---------- */
  .hero{
    background:
      radial-gradient(ellipse 700px 420px at 18% -10%, rgba(242,166,61,.14), transparent 60%),
      radial-gradient(ellipse 600px 500px at 100% 10%, rgba(255,68,56,.12), transparent 60%),
      var(--ink);
    color:var(--chalk);
    padding:76px 0 0;
    position:relative;
    overflow:hidden;
  }
  .hero .wrap{position:relative; z-index:2;}
  .hero .eyebrow{color:var(--scarlet);}
  .hero h1{
    font-family:var(--font-display);
    font-weight:400;
    font-size:clamp(42px, 8vw, 88px);
    line-height:.98;
    letter-spacing:.005em;
    margin:20px 0 22px;
    max-width:14ch;
  }
  .hero h1 .accent{color:var(--volt);}
  .hero p.lede{
    font-size:18px; color:var(--slate); max-width:46ch; margin-bottom:34px;
  }
  .hero-cta{display:flex; gap:14px; flex-wrap:wrap; margin-bottom:56px;}
  .btn{
    font-family:var(--font-mono); font-weight:600; font-size:13px;
    letter-spacing:.06em; text-transform:uppercase;
    padding:14px 24px; border-radius:3px; display:inline-block;
    transition:transform .15s ease, background .15s ease;
  }
  .btn-primary{background:var(--volt); color:var(--ink);}
  .btn-primary:hover{transform:translateY(-2px);}
  .btn-ghost{border:1px solid var(--inkline); color:var(--chalk);}
  .btn-ghost:hover{border-color:var(--volt); color:var(--volt);}

  /* ---------- scoreboard ticker ---------- */
  .ticker{
    border-top:1px solid var(--inkline);
    background:var(--ink-2);
    overflow:hidden;
    position:relative;
  }
  .ticker-label{
    position:absolute; left:0; top:0; bottom:0; z-index:2;
    display:flex; align-items:center; gap:8px;
    background:var(--ink-2);
    padding:0 18px 0 28px;
    font-family:var(--font-mono); font-size:11px; letter-spacing:.12em;
    color:var(--scarlet); text-transform:uppercase; font-weight:600;
    box-shadow:24px 0 24px -8px var(--ink-2);
  }
  .ticker-track{
    display:flex; white-space:nowrap;
    animation:scroll-left 42s linear infinite;
    padding-left:150px;
  }
  @media (prefers-reduced-motion: reduce){ .ticker-track{animation:none;} }
  .ticker-track span.item{
    font-family:var(--font-mono); font-size:13px; color:var(--slate);
    padding:16px 34px; border-right:1px solid var(--inkline);
  }
  .ticker-track span.item b{color:var(--chalk); font-weight:500;}
  @keyframes scroll-left{
    from{transform:translateX(0);}
    to{transform:translateX(-50%);}
  }

  /* ---------- section shell ---------- */
  section{padding:88px 0;}
  .section-head{
    display:flex; align-items:flex-end; justify-content:space-between;
    gap:24px; margin-bottom:44px; flex-wrap:wrap;
  }
  .section-head .eyebrow{color:var(--scarlet); margin-bottom:14px;}
  .section-head h2{font-family:var(--font-display); font-weight:400; font-size:clamp(28px,4vw,42px);}
  .section-head p{color:#5b6472; max-width:40ch; font-size:15px;}

  /* ---------- stories grid ---------- */
  .stories{display:grid; grid-template-columns:1.3fr 1fr 1fr; gap:24px;}
  @media (max-width:920px){ .stories{grid-template-columns:1fr 1fr;} }
  @media (max-width:640px){ .stories{grid-template-columns:1fr;} }
  .story-card{
    background:#fff;
    border:1px solid #DEDACB;
    border-radius:6px;
    padding:26px 24px 24px;
    display:flex; flex-direction:column; gap:16px;
    transition:transform .18s ease, box-shadow .18s ease, border-color .18s ease;
  }
  .story-card:hover{
    transform:translateY(-4px);
    box-shadow:0 16px 34px -18px rgba(11,18,32,.35);
    border-color:var(--ink);
  }
  .story-card.feature{grid-row:span 2; padding:34px 30px;}
  .tag{
    align-self:flex-start;
    font-family:var(--font-mono); font-size:10.5px; letter-spacing:.1em;
    text-transform:uppercase; font-weight:600;
    padding:5px 10px; border-radius:20px;
    background:var(--pitch); color:var(--volt);
  }
  .story-card h3{
    font-size:19px; font-weight:800; line-height:1.28;
  }
  .story-card.feature h3{font-size:27px; line-height:1.2;}
  .story-card .meta{
    font-family:var(--font-mono); font-size:12px; color:var(--slate); color:#8A8570;
    margin-top:auto; display:flex; align-items:center; gap:8px;
  }
  .story-card .read{
    font-family:var(--font-mono); font-size:12px; font-weight:600;
    color:var(--ink); border-top:1px dashed #DEDACB; padding-top:14px;
    display:flex; justify-content:space-between; align-items:center;
  }
  .story-card:hover .read{color:var(--scarlet);}

  /* ---------- categories ---------- */
  .categories{background:var(--pitch); color:var(--chalk);}
  .categories .section-head .eyebrow{color:var(--volt);}
  .categories .section-head p{color:#B7CFC2;}
  .cat-grid{
    display: flex; 
    gap: 18px;
    overflow-x: auto; 
    scroll-snap-type: x mandatory; 
    padding-bottom: 16px;
  }
  
  .cat-grid::-webkit-scrollbar { display: none; }
  .cat-grid { -ms-overflow-style: none; scrollbar-width: none; }

  .cat-tile{
    flex: 0 0 280px; 
    scroll-snap-align: start; 
    border:1px solid var(--pitch-line);
    border-radius:6px;
    padding:26px 20px;
    background:rgba(255,255,255,.02);
    transition:border-color .15s ease, background .15s ease;
  }
  .cat-tile:hover{border-color:var(--volt); background:rgba(242,166,61,.05);}
  .cat-tile .num{
    font-family:var(--font-mono); font-size:12px; color:var(--volt); margin-bottom:18px; display:block;
  }
  .cat-tile h3{font-family:var(--font-display); font-weight:400; font-size:22px; margin-bottom:12px;}
  .cat-tile ul li{font-size:13px; color:#B7CFC2; padding:4px 0;}
  .cat-tile ul li a:hover{color:var(--volt);}

  /* ---------- newsletter / sub form ---------- */
  .subscribe{background:var(--ink); color:var(--chalk);}
  .sub-panel{
    display:grid; grid-template-columns:1.1fr 1fr; gap:50px; align-items:center;
    border:1px solid var(--inkline); border-radius:10px; padding:52px;
    background:linear-gradient(135deg, rgba(242,166,61,.05), transparent 60%);
  }
  @media (max-width:820px){ .sub-panel{grid-template-columns:1fr; padding:36px 26px;} }
  .sub-panel h2{font-family:var(--font-display); font-weight:400; font-size:clamp(26px,4vw,38px); margin-bottom:14px;}
  .sub-panel p{color:var(--slate); max-width:40ch;}
  
  /* FIXED: Set to block so children stack vertically on desktop instead of crushing side-by-side */
  form.sub-form{display:block;}
  
  .email-input-group {
    display: flex; 
    border: 1px solid var(--inkline); 
    border-radius: 4px; 
    overflow: hidden;
  }
  .email-input-group input {
    flex: 1; background: var(--ink-2); border: none; color: var(--chalk);
    padding: 16px 18px; font-family: var(--font-mono); font-size: 13px;
  }
  .email-input-group input::placeholder{color:var(--slate);}
  .email-input-group input:focus{outline:none;}
  .email-input-group button {
    background: var(--volt); border: none; padding: 0 22px;
    font-family: var(--font-mono); font-weight: 700; letter-spacing: .06em; 
    text-transform: uppercase; font-size: 12px; cursor: pointer;
  }
  
  /* MOBILE FIX: Stack the email input and button on small screens */
  @media (max-width: 560px) {
    .email-input-group {
      flex-direction: column;
      border: none;
      overflow: visible;
      gap: 12px;
    }
    .email-input-group input {
      border: 1px solid var(--inkline);
      border-radius: 4px;
      width: 100%;
    }
    .email-input-group button {
      padding: 16px 22px;
      border-radius: 4px;
      width: 100%;
    }
  }

  .sub-note{font-family:var(--font-mono); font-size:11px; color:var(--slate); margin-top:12px;}
  .whatsapp-link{
    display:inline-flex; align-items:center; gap:8px; margin-top:22px;
    font-family:var(--font-mono); font-size:12px; color:#3ee08c; font-weight:600;
  }

  /* ---------- dual-tier subscribe options ---------- */
  .free-badge{
    display:inline-block; font-family:var(--font-mono); font-size:10px; letter-spacing:.08em; text-transform:uppercase;
    font-weight:700; color:var(--pitch); background:var(--volt); padding:3px 9px; border-radius:12px; margin-bottom:12px;
  }
  .tier-options{display:flex; flex-direction:column; gap:12px; margin-bottom:22px;}
  
  .tier-option{
    display:flex; gap:14px; align-items:flex-start; padding:16px; border:1px solid var(--inkline); border-radius:6px;
    cursor:pointer; transition:border-color .15s ease, background .15s ease;
    min-height: 80px; 
    height: auto; 
  }
  .tier-option:hover, .tier-option.checked{border-color:var(--volt); background:rgba(242,166,61,.05);}
  .tier-option input[type="checkbox"]{
    appearance:none; width:18px; height:18px; border:1px solid var(--slate); border-radius:4px; flex:none; margin-top:2px;
    display:flex; align-items:center; justify-content:center; cursor:pointer;
  }
  .tier-option input[type="checkbox"]:checked{background:var(--volt); border-color:var(--volt);}
  .tier-option input[type="checkbox"]:checked::after{content:"✓"; color:var(--ink); font-size:12px; font-weight:700; display:block; text-align:center; line-height:16px;}
  .tier-option .t-title{
    display: block; 
    font-weight: 700; 
    font-size: 14.5px; 
    margin-bottom: 6px; 
  }
  .tier-option .t-desc{
    display: block; 
    font-size: 13px; 
    color: var(--slate); 
    line-height: 1.5; 
  }
  .trust-note{
    display:flex; gap:10px; align-items:flex-start; margin-top:18px; padding-top:18px; border-top:1px dashed var(--inkline);
    font-size:12.5px; color:var(--slate); line-height:1.6;
  }
</style>

<section class="hero">
  <div class="wrap">
    <span class="eyebrow"><span class="dot"></span>Live coverage, every match day</span>
    <h1>ONE PLACE.<br>EVERY FIELD.<br><span class="accent">EVERY SCORE.</span></h1>
    <p class="lede">Cricket, football, tennis and the Olympics — reported fast, explained straight, no fluff. Lightning Sports has been calling the plays since 2021.</p>
    <div class="hero-cta">
      <a href="#latest" class="btn btn-primary">Read the latest</a>
      <a href="#subscribe" class="btn btn-ghost">Get the newsletter</a>
    </div>
  </div>

  <div class="ticker" role="marquee" aria-label="Latest headlines ticker">
    <div class="ticker-label"><span class="dot"></span>Headlines</div>
    <div class="ticker-track">
      {[...latestPosts, ...latestPosts].map((post) => (
          <span class="item">
            <b>●</b>
            <span set:html={post.data.title}></span>
          </span>
      ))}
    </div>
  </div>
</section>

<section id="latest">
  <div class="wrap">
    <div class="section-head">
      <div>
        <span class="eyebrow"><span class="dot"></span>Latest stories</span>
        <h2>From the desk this week</h2>
      </div>
      <p>Straight-talking recaps and schedules, filed the moment the whistle blows.</p>
    </div>

    <div class="stories">
      {latestPosts.map((post, index) => (
        <a class={`story-card ${index === 0 ? 'feature' : ''}`} href={`/posts/${post.id}`}>
          
          <span class="tag">{(Array.isArray(post.data.category) ? post.data.category[0] : post.data.category || 'Sports').replace(/-/g, ' ').toUpperCase()}</span>
          
          <h3 set:html={formatTitle(post.data.title)}></h3>
          
          {index === 0 && (
              <p style="color:#5b6472;font-size:14.5px;">
                {generateCleanExcerpt(post.body, 280)}
              </p>
          )}
          
          <div class="meta">
              {formatDate(post.data.date).toUpperCase()}
          </div>
          
          <div class="read">
              <span>Read the story</span>
              <span>→</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<section id="most-viewed">
  <div class="wrap">
    <div class="section-head">
      <div>
        <span class="eyebrow"><span class="dot"></span>Reader favorites</span>
        <h2>Most viewed right now</h2>
      </div>
      <p>What everyone else is reading — updated as real traffic comes in.</p>
    </div>

    {topViewedPosts.length === 0 ? (
      <p style="font-family:var(--font-mono); font-size:13px; color:#5b6472;">
        No traffic data yet — this fills in automatically once readers start visiting posts.
      </p>
    ) : (
      <div class="stories">
        {topViewedPosts.map((post, index) => (
          <a class={`story-card ${index === 0 ? 'feature' : ''}`} href={`/posts/${post.id}`}>
            <span class="tag">{categoryLabel(Array.isArray(post.data.category) ? post.data.category[0] : post.data.category).toUpperCase()}</span>
            <h3 set:html={formatTitle(post.data.title)}></h3>
            <div class="read"><span>Read the story</span><span>→</span></div>
          </a>
        ))}
      </div>
    )}
  </div>
</section>

<section class="categories" id="categories">
  <div class="wrap">
    <div class="section-head">
      <div>
        <span class="eyebrow"><span class="dot"></span>Beats we cover</span>
        <h2>Pick your sport</h2>
      </div>
      <p>Continuous coverage of the sports that matter, and the global events where they collide.</p>
    </div>
    
    <div class="cat-grid" style="margin-bottom: 32px;">
      {topSports.map(([cat, count], i) => (
        <a class="cat-tile" href={`/category/${cat.toLowerCase().replace(/\s+/g, '-')}`} style="display:block;">
          <span class="num">{String(i + 1).padStart(2, '0')} / {categoryLabel(cat).toUpperCase()}</span>
          <h3>{categoryLabel(cat)}</h3>
          <p style="font-family:var(--font-mono); font-size:12px; color:#B7CFC2;">{count} {count === 1 ? 'story' : 'stories'}</p>
        </a>
      ))}
    </div>

    {topEvents.length > 0 && (
      <>
        <h3 style="font-family:var(--font-mono); font-size:12px; color:#8B97A6; text-transform:uppercase; letter-spacing:0.1em; margin-bottom: 16px; border-top: 1px solid var(--pitch-line); padding-top: 24px;">Major Events</h3>
        <div class="cat-grid" style="grid-template-columns: repeat(2, 1fr); margin-bottom: 28px;">
          {topEvents.map(([cat, count], i) => (
            <a class="cat-tile" href={`/category/${cat.toLowerCase().replace(/\s+/g, '-')}`} style="display:block;">
              <span class="num">EVENT / {categoryLabel(cat).toUpperCase()}</span>
              <h3>{categoryLabel(cat)}</h3>
              <p style="font-family:var(--font-mono); font-size:12px; color:#B7CFC2;">{count} {count === 1 ? 'story' : 'stories'}</p>
            </a>
          ))}
        </div>
      </>
    )}

    <div style="text-align:center; margin-top:28px;">
      <a href="/sports" class="btn btn-ghost" style="border-color:var(--pitch-line); color:var(--chalk);">View all sports →</a>
    </div>
  </div>
</section>

